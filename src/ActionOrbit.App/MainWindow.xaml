<Window x:Class="ActionOrbit.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Action Orbit"
        Width="1120"
        Height="780"
        MinWidth="1040"
        MinHeight="720"
        Background="#F4F5F7"
        Foreground="#171A20"
        SourceInitialized="Window_SourceInitialized">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#171A20" />
        </Style>

        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B7280" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="TinyLabel" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        </Style>

        <Style x:Key="Surface" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E3E6EC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style x:Key="SoftSurface" TargetType="Border">
            <Setter Property="Background" Value="#F8F9FB" />
            <Setter Property="BorderBrush" Value="#E4E7ED" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12" />
        </Style>

        <Style x:Key="ButtonBase" TargetType="Button">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="13,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#171A20" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#DCE1EA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="#F2F4F7" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="#E9EDF3" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" BasedOn="{StaticResource ButtonBase}" />

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="#111318" />
            <Setter Property="BorderBrush" Value="#111318" />
        </Style>

        <Style x:Key="SubtleButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Background" Value="#F7F8FA" />
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Foreground" Value="#9F1239" />
            <Setter Property="Background" Value="#FFF5F7" />
            <Setter Property="BorderBrush" Value="#F8CED8" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Foreground" Value="#171A20" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#DCE1EA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Foreground" Value="#171A20" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#DCE1EA" />
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>

        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="#171A20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style x:Key="CleanListBoxItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemShell"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="12">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemShell" Property="Background" Value="#F5F6F8" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemShell" Property="Background" Value="#EEF1F6" />
                                <Setter TargetName="ItemShell" Property="BorderBrush" Value="#D8DEE8" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                <Setter TargetName="ItemShell" Property="Background" Value="#EAF1FF" />
                                <Setter TargetName="ItemShell" Property="BorderBrush" Value="#8EA8FF" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconTileItem" TargetType="ListBoxItem">
            <Setter Property="Width" Value="82" />
            <Setter Property="Height" Value="62" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="IconShell"
                                Padding="7"
                                Background="#FFFFFF"
                                BorderBrush="#E3E6EC"
                                BorderThickness="1"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="IconShell" Property="Background" Value="#F6F8FB" />
                                <Setter TargetName="IconShell" Property="BorderBrush" Value="#CED6E2" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="IconShell" Property="Background" Value="#111318" />
                                <Setter TargetName="IconShell" Property="BorderBrush" Value="#111318" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="PresetTemplate">
            <Grid MinHeight="42">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="30"
                        Height="30"
                        Margin="0,0,10,0"
                        Background="#F1F3F6"
                        CornerRadius="15">
                    <Grid>
                        <Image Width="17"
                               Height="17"
                               Source="{Binding ImagePath}"
                               Stretch="Uniform"
                               Visibility="{Binding HasImage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Viewbox Width="16"
                                 Height="16"
                                 Visibility="{Binding HasPaths, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid Width="24" Height="24">
                            <ItemsControl ItemsSource="{Binding IconPaths}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Grid />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Path Data="{Binding}"
                                              Fill="Transparent"
                                              Stroke="#171A20"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              StrokeStartLineCap="Round"
                                              StrokeThickness="2" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                        </Viewbox>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock FontWeight="SemiBold"
                               Text="{Binding Title}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Style="{StaticResource MutedText}"
                               Text="{Binding Description}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="IconTileTemplate">
            <StackPanel HorizontalAlignment="Center">
                <Image Width="22"
                       Height="22"
                       HorizontalAlignment="Center"
                       Source="{Binding ImagePath}"
                       Stretch="Uniform"
                       Visibility="{Binding HasImage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <Viewbox Width="20"
                         Height="20"
                         HorizontalAlignment="Center"
                         Visibility="{Binding HasPaths, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid Width="24" Height="24">
                        <ItemsControl ItemsSource="{Binding Paths}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Grid />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Path Data="{Binding}"
                                          Fill="Transparent"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeThickness="2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Viewbox>
                <TextBlock Margin="0,5,0,0"
                           HorizontalAlignment="Center"
                           FontSize="10"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                           Text="{Binding Label}"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ProfileTemplate">
            <Grid Margin="2" MinHeight="58">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="34"
                        Height="34"
                        Margin="10,0,10,0"
                        VerticalAlignment="Center"
                        Background="#111318"
                        CornerRadius="17">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="#FFFFFF"
                               FontWeight="Bold"
                               Text="P" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock FontWeight="SemiBold"
                               Text="{Binding Name}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Margin="0,2,0,0"
                               Style="{StaticResource MutedText}"
                               Text="{Binding Id}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Margin="0,2,0,0"
                               Style="{StaticResource MutedText}"
                               Text="{Binding Matches.Count, StringFormat={}{0} uygulama bağlı}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ActionRowTemplate">
            <Grid Margin="2" MinHeight="48">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding Indent}" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0"
                      Visibility="{Binding IsChild, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border Width="2"
                            Margin="0,7,8,7"
                            HorizontalAlignment="Right"
                            Background="#D8DEE8"
                            CornerRadius="2" />
                </Grid>

                <Border Grid.Column="1"
                        Width="36"
                        Height="36"
                        VerticalAlignment="Center"
                        Background="#F1F3F6"
                        BorderBrush="#E0E4EB"
                        BorderThickness="1"
                        CornerRadius="18">
                    <Grid>
                        <Image Width="19"
                               Height="19"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Source="{Binding IconImagePath}"
                               Stretch="Uniform"
                               Visibility="{Binding HasIconImage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Viewbox Width="18"
                                 Height="18"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Visibility="{Binding HasIconPaths, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid Width="24" Height="24">
                                <ItemsControl ItemsSource="{Binding IconPaths}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Grid />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Path Data="{Binding}"
                                                  Fill="Transparent"
                                                  Stroke="#171A20"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  StrokeStartLineCap="Round"
                                                  StrokeThickness="2" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Viewbox>
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe UI Symbol"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Text="{Binding DisplayIcon}"
                                   Visibility="{Binding HasFallbackIcon, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2" Margin="11,0,0,0" VerticalAlignment="Center">
                    <TextBlock FontWeight="SemiBold"
                               Text="{Binding Title}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Style="{StaticResource MutedText}"
                               Text="{Binding RowSubtitle}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Border Grid.Column="3"
                        Margin="8,0,8,0"
                        Padding="8,4"
                        VerticalAlignment="Center"
                        Background="#F8F9FB"
                        BorderBrush="#E3E6EC"
                        BorderThickness="1"
                        CornerRadius="999"
                        Visibility="{Binding IsFolder, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#4B5563"
                               Text="klasör" />
                </Border>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock FontSize="30"
                           FontWeight="Bold"
                           Text="Action Orbit" />
                <TextBlock Margin="0,5,0,0"
                           Style="{StaticResource MutedText}"
                           Text="Mouse makro tuşuna bağladığın hotkey ile imlecin yanında action ring açılır." />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <Border Margin="0,0,10,0"
                        Padding="12,8"
                        Background="{Binding HotkeyBadgeBackground}"
                        BorderBrush="#E3E6EC"
                        BorderThickness="1"
                        CornerRadius="12">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="9"
                                 Height="9"
                                 Margin="0,0,9,0"
                                 VerticalAlignment="Center"
                                 Fill="{Binding HotkeyDotBrush}" />
                        <TextBlock Margin="0,0,8,0"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding HotkeyBadgeForeground}"
                                   Text="{Binding HotkeyStateText}" />
                        <TextBlock FontWeight="SemiBold"
                                   Foreground="{Binding HotkeyBadgeForeground}"
                                   Text="{Binding HotkeyDisplay}" />
                    </StackPanel>
                </Border>
                <Button Click="RunInBackground_Click"
                        Style="{StaticResource SubtleButton}"
                        Content="Arka planda çalıştır" />
                <Button Command="{Binding ShowOverlayCommand}"
                        Style="{StaticResource SubtleButton}"
                        Content="Önizle" />
                <Button Command="{Binding SaveConfigCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Content="Kaydet" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Margin="0,16,0,0"
                Style="{StaticResource SoftSurface}">
            <Expander Header="Kurulum, hotkey ve dosyalar"
                      IsExpanded="False">
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.35*" />
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock FontWeight="Bold" Text="İlk kurulum" />
                    <TextBlock Margin="0,5,14,0"
                               Style="{StaticResource MutedText}"
                               TextWrapping="Wrap"
                               Text="1. Mouse yazılımında makro tuşuna bu hotkey'i ata. 2. Önizle ile halkayı test et. 3. Aktif uygulamayı ilgili profile ekle." />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="12,0,14,0">
                    <TextBlock Style="{StaticResource TinyLabel}" Text="Hotkey" />
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Margin="0,0,8,0"
                                 Text="{Binding HotkeyInput, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1"
                                Command="{Binding SaveHotkeyCommand}"
                                Content="Kısayolu Kaydet" />
                    </Grid>
                    <TextBlock Margin="0,7,0,0"
                               Style="{StaticResource MutedText}"
                               Text="Örn: Ctrl+Alt+Shift+R, F13, F14, Ctrl+Space" />
                </StackPanel>

                <StackPanel Grid.Column="2"
                            VerticalAlignment="Bottom"
                            Orientation="Horizontal">
                    <Button Command="{Binding OpenConfigFolderCommand}" Content="Config Klasörü" />
                    <Button Command="{Binding OpenConfigCommand}" Content="JSON Aç" />
                    <Button Command="{Binding OpenLogCommand}" Content="Log Aç" />
                </StackPanel>
            </Grid>
            </Expander>
        </Border>

        <Border Grid.Row="2"
                Margin="0,12,0,0"
                Style="{StaticResource SoftSurface}">
            <Expander Header="Uygulama ayarları, tema ve aktarım"
                      IsExpanded="False">
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*" />
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="1.3*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock FontWeight="Bold" Text="Uygulama" />
                    <CheckBox Margin="0,8,0,0"
                              Content="Windows ile başlat"
                              IsChecked="{Binding StartupWithWindows}" />
                    <CheckBox Margin="0,6,0,0"
                              Content="Kapatınca tray'e al"
                              IsChecked="{Binding CloseToTray}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                    <TextBlock FontWeight="Bold" Text="Tema" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0"
                                  Margin="0,0,8,0"
                                  ItemsSource="{Binding ThemeModeOptions}"
                                  SelectedItem="{Binding ThemeMode}" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding AccentInput, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <TextBlock Margin="0,5,0,0"
                               Style="{StaticResource MutedText}"
                               Text="Accent örn: #A51E39" />
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="16,0,0,0">
                    <TextBlock FontWeight="Bold" Text="Overlay" />
                    <Grid Margin="0,7,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="38" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource MutedText}" Text="Buton" />
                        <Slider Grid.Column="1" Minimum="54" Maximum="96" Value="{Binding OverlayButtonSize}" />
                        <TextBlock Grid.Column="2" HorizontalAlignment="Right" Style="{StaticResource MutedText}" Text="{Binding OverlayButtonSize}" />
                    </Grid>
                    <Grid Margin="0,3,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="38" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource MutedText}" Text="Yatay" />
                        <Slider Grid.Column="1" Minimum="96" Maximum="190" Value="{Binding OverlayRadiusX}" />
                        <TextBlock Grid.Column="2" HorizontalAlignment="Right" Style="{StaticResource MutedText}" Text="{Binding OverlayRadiusX}" />
                    </Grid>
                    <Grid Margin="0,3,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="38" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource MutedText}" Text="Dikey" />
                        <Slider Grid.Column="1" Minimum="82" Maximum="168" Value="{Binding OverlayRadiusY}" />
                        <TextBlock Grid.Column="2" HorizontalAlignment="Right" Style="{StaticResource MutedText}" Text="{Binding OverlayRadiusY}" />
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Column="3"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center">
                    <TextBlock FontWeight="Bold" Text="Aktarım" />
                    <WrapPanel Margin="0,8,0,0">
                        <Button Command="{Binding ApplyThemeSettingsCommand}" Content="Ayarları Kaydet" />
                        <Button Command="{Binding ExportConfigCommand}" Content="Config Dışa Aktar" />
                        <Button Command="{Binding ImportConfigCommand}" Content="Config İçe Aktar" />
                    </WrapPanel>
                    <WrapPanel Margin="0,8,0,0">
                        <Button Command="{Binding ExportProfileCommand}" Content="Profili Dışa Aktar" />
                        <Button Command="{Binding ImportProfileCommand}" Content="Profil İçe Aktar" />
                    </WrapPanel>
                </StackPanel>
            </Grid>
            </Expander>
        </Border>

        <Grid Grid.Row="3" Margin="0,12,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Margin="0,0,14,0"
                    Style="{StaticResource Surface}">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top">
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock FontSize="18" FontWeight="Bold" Text="1. Profiller" />
                                <TextBlock Margin="0,4,0,0"
                                           Style="{StaticResource MutedText}"
                                           Text="{Binding ProfileCount, StringFormat={}{0} profil yüklü}" />
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Command="{Binding AddProfileCommand}"
                                        Padding="10,6"
                                        Content="+ Profil" />
                                <Button Command="{Binding DeleteProfileCommand}"
                                        Padding="10,6"
                                        Style="{StaticResource DangerButton}"
                                        Content="Sil" />
                            </StackPanel>
                        </DockPanel>

                        <Border Margin="0,14,0,14"
                                Style="{StaticResource SoftSurface}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource TinyLabel}" Text="Profil adı" />
                                <TextBox Margin="0,6,0,10"
                                         Text="{Binding SelectedProfileName, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Style="{StaticResource TinyLabel}" Text="Profil ID" />
                                <TextBox Margin="0,6,0,10"
                                         Text="{Binding SelectedProfileId, UpdateSourceTrigger=PropertyChanged}" />
                                <Border Margin="0,0,0,10"
                                        Padding="8,4"
                                        HorizontalAlignment="Left"
                                        Background="#EEF2FF"
                                        BorderBrush="#D8E0FF"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Visibility="{Binding SelectedProfileIsDefault, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#3730A3"
                                               Text="Varsayılan profil" />
                                </Border>
                                <TextBlock Style="{StaticResource TinyLabel}" Text="Çalışan uygulamadan seç" />
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0"
                                              Margin="0,0,8,0"
                                              DisplayMemberPath="DisplayName"
                                              ItemsSource="{Binding RunningApps}"
                                              SelectedItem="{Binding SelectedRunningApp}" />
                                    <Button Grid.Column="1"
                                            Command="{Binding RefreshRunningAppsCommand}"
                                            Content="Yenile" />
                                </Grid>
                                <WrapPanel Margin="0,8,0,12">
                                    <Button Command="{Binding AddSelectedRunningAppToProfileCommand}"
                                            Content="Seçileni Ekle" />
                                    <Button Command="{Binding AddActiveProcessToProfileCommand}"
                                            Content="Aktifi Ekle" />
                                </WrapPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource TinyLabel}" Text="Aktif:" />
                                    <TextBlock Grid.Column="1"
                                               Margin="6,0,0,0"
                                               FontFamily="Consolas"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Text="{Binding ActiveProcessName}"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                                <TextBlock Style="{StaticResource TinyLabel}" Text="Bu profile bağlı uygulamalar" />
                                <ItemsControl Margin="0,9,0,0"
                                              ItemsSource="{Binding SelectedProfileMatchChips}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,6,6"
                                                    Padding="8,4"
                                                    Background="#FFFFFF"
                                                    BorderBrush="#DCE1EA"
                                                    BorderThickness="1"
                                                    CornerRadius="10">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock VerticalAlignment="Center"
                                                               FontFamily="Consolas"
                                                               FontSize="11"
                                                               Text="{Binding}" />
                                                    <Button MinWidth="0"
                                                            MinHeight="0"
                                                            Margin="6,0,0,0"
                                                            Padding="5,0"
                                                            Command="{Binding DataContext.RemoveProfileMatchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Content="x"
                                                            FontSize="11" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Margin="0,7,0,0"
                                           Style="{StaticResource MutedText}"
                                           Text="Elle düzenlemek istersen aşağıdaki listeyi kullanabilirsin." />
                                <TextBox Margin="0,6,0,0"
                                         MinHeight="48"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         Text="{Binding SelectedProfileMatchesText, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="0,7,0,0"
                                           Style="{StaticResource MutedText}"
                                           Text="Örn: chrome.exe, Code.exe, explorer.exe, mstsc.exe" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <ListBox ItemsSource="{Binding Profiles}"
                             SelectedItem="{Binding SelectedProfile}"
                             ItemTemplate="{StaticResource ProfileTemplate}"
                             ItemContainerStyle="{StaticResource CleanListBoxItem}" />
                </DockPanel>
            </Border>

            <Border Grid.Column="1"
                    Margin="0,0,14,0"
                    Style="{StaticResource Surface}">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock FontSize="18" FontWeight="Bold" Text="2. Aksiyonlar" />
                        <TextBlock Margin="0,4,0,14"
                                   Style="{StaticResource MutedText}"
                                   Text="Sıralama halkadaki konumu belirler." />
                        <TextBlock Margin="0,-8,0,14"
                                   Style="{StaticResource MutedText}"
                                   Text="Aksiyonu bir klasör satırının üstüne bırakıp alt aksiyon yapabilirsin." />
                        <WrapPanel Margin="0,0,0,12">
                            <Button Command="{Binding AddActionCommand}" Content="+ Aksiyon" />
                            <Button Command="{Binding AddFolderCommand}" Content="+ Klasör" />
                            <Button Command="{Binding AddChildActionCommand}" Content="+ Alt Aksiyon" />
                        </WrapPanel>
                        <Border Margin="0,0,0,12"
                                Style="{StaticResource SoftSurface}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource TinyLabel}" Text="Hazır eylem" />
                                <Grid Margin="0,7,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0"
                                              Margin="0,0,8,0"
                                              ItemTemplate="{StaticResource PresetTemplate}"
                                              ItemsSource="{Binding ActionPresets}"
                                              SelectedItem="{Binding SelectedPreset}" />
                                    <Button Grid.Column="1"
                                            Command="{Binding ApplyPresetCommand}"
                                            Content="Uygula" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <WrapPanel>
                            <Button Command="{Binding MoveActionUpCommand}" Content="Yukarı" />
                            <Button Command="{Binding MoveActionDownCommand}" Content="Aşağı" />
                            <Button Command="{Binding MoveActionOutOfFolderCommand}"
                                    Content="Klasörden Çıkar"
                                    IsEnabled="{Binding CanMoveSelectedActionOutOfFolder}" />
                            <Button Command="{Binding DeleteActionCommand}"
                                    Style="{StaticResource DangerButton}"
                                    Content="Sil" />
                        </WrapPanel>
                    </StackPanel>

                    <ListBox x:Name="ActionList"
                             ItemsSource="{Binding ActionRows}"
                             SelectedItem="{Binding SelectedAction}"
                             ItemTemplate="{StaticResource ActionRowTemplate}"
                             ItemContainerStyle="{StaticResource CleanListBoxItem}"
                             AllowDrop="True"
                             PreviewMouseLeftButtonDown="ActionList_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="ActionList_PreviewMouseMove"
                             DragOver="ActionList_DragOver"
                             DragLeave="ActionList_DragLeave"
                             Drop="ActionList_Drop" />
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Surface}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel LastChildFill="True">
                        <StackPanel>
                            <TextBlock FontSize="18" FontWeight="Bold" Text="3. Seçili Aksiyon" />
                            <TextBlock Margin="0,4,0,0"
                                       Style="{StaticResource MutedText}"
                                       Text="Buton adı, ikon, tip ve hedef değerlerini düzenle." />
                        </StackPanel>
                    </DockPanel>

                    <Border Grid.Row="1"
                            Margin="0,16,0,0"
                            Style="{StaticResource SoftSurface}"
                            Visibility="{Binding HasNoSelectedAction, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontSize="16"
                                       FontWeight="Bold"
                                       Text="Düzenlemek için bir aksiyon seç" />
                            <TextBlock Margin="0,7,0,0"
                                       Style="{StaticResource MutedText}"
                                       TextWrapping="Wrap"
                                       Text="Soldan bir aksiyon seçebilir, yeni aksiyon ekleyebilir veya hazır eylem uygulayabilirsin." />
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1"
                                  Margin="0,16,0,0"
                                  VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding HasSelectedAction, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel DataContext="{Binding SelectedAction}">
                            <Border Style="{StaticResource SoftSurface}"
                                    DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource TinyLabel}" Text="Hazır eylem uygula" />
                                        <ComboBox Margin="0,7,12,0"
                                                  ItemTemplate="{StaticResource PresetTemplate}"
                                                  ItemsSource="{Binding ActionPresets}"
                                                  SelectedItem="{Binding SelectedPreset}" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            VerticalAlignment="Bottom"
                                            Command="{Binding ApplyPresetCommand}"
                                            Content="Uygula" />
                                </Grid>
                            </Border>

                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="0" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Visibility="Collapsed">
                                    <TextBlock Style="{StaticResource TinyLabel}" Text="İkon" />
                                    <ComboBox Margin="0,6,12,0"
                                              IsEditable="True"
                                              ItemsSource="{Binding DataContext.AvailableIconKeys, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding Icon, UpdateSourceTrigger=PropertyChanged}"
                                              Text="{Binding Icon, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Style="{StaticResource TinyLabel}" Text="Ad" />
                                    <TextBox Margin="0,6,12,0"
                                             Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Visibility="Collapsed">
                                    <TextBlock Style="{StaticResource TinyLabel}" Text="ID (otomatik)" />
                                    <TextBox Margin="0,6,0,0"
                                             Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                            <Border Margin="0,14,0,0"
                                    Padding="10"
                                    Background="#EEF2FF"
                                    BorderBrush="#D8E0FF"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Visibility="{Binding IsFolder, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold"
                                               Foreground="#3730A3"
                                               Text="{Binding FolderBadgeText, StringFormat=Bu klasörde {0} aksiyon var.}" />
                                    <TextBlock Margin="0,4,0,0"
                                               Style="{StaticResource MutedText}"
                                               TextWrapping="Wrap"
                                               Text="+ Alt Aksiyon ile yeni child ekleyebilir veya soldaki listeden bir aksiyonu bu klasör satırının üstüne bırakabilirsin." />
                                </StackPanel>
                            </Border>

                            <Border Margin="0,14,0,0"
                                    Padding="10"
                                    Background="#F8F9FB"
                                    BorderBrush="#E3E6EC"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Visibility="{Binding IsChild, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <DockPanel LastChildFill="True">
                                    <Button DockPanel.Dock="Right"
                                            Margin="10,0,0,0"
                                            Padding="10,5"
                                            Command="{Binding DataContext.MoveActionOutOfFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Content="Klasörden Çıkar" />
                                    <TextBlock VerticalAlignment="Center"
                                               Style="{StaticResource MutedText}"
                                               Text="{Binding ParentTitle, StringFormat=Bu aksiyon {0} klasörünün içinde.}"
                                               TextWrapping="Wrap" />
                                </DockPanel>
                            </Border>

                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource TinyLabel}" Text="Eylem türü" />
                                    <ComboBox Margin="0,6,12,0"
                                              DisplayMemberPath="Label"
                                              ItemsSource="{Binding DataContext.ActionTypeOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedValue="{Binding Type, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="Key" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Style="{StaticResource TinyLabel}" Text="{Binding TargetLabel}" />
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 MinHeight="{Binding TargetBoxMinHeight}"
                                                 AcceptsReturn="True"
                                                 IsEnabled="{Binding IsTargetEditable}"
                                                 TextWrapping="Wrap"
                                                 Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Grid.Column="1"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Top"
                                                Command="{Binding DataContext.BrowseActionTargetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Content="Gözat"
                                                Visibility="{Binding DataContext.CanBrowseSelectedAction, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <TextBlock Margin="0,8,0,0"
                                       Style="{StaticResource MutedText}"
                                       Text="{Binding TypeHelp}"
                                       TextWrapping="Wrap" />

                            <Border Margin="0,10,0,0"
                                    Padding="10"
                                    Background="#FFF7ED"
                                    BorderBrush="#FED7AA"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Visibility="{Binding IsRunCommand, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Foreground="#9A3412"
                                           TextWrapping="Wrap"
                                           Text="Komut çalıştırma gelişmiş kullanımdır. Yalnızca güvendiğin komutları ekle." />
                            </Border>

                            <Border Margin="0,10,0,0"
                                    Padding="10"
                                    Background="#FFF1F2"
                                    BorderBrush="#FECDD3"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Visibility="{Binding HasSelectedActionValidation, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Foreground="#9F1239"
                                           Text="{Binding SelectedActionValidationMessage}"
                                           TextWrapping="Wrap" />
                            </Border>

                            <TextBlock Margin="0,16,0,0"
                                       Style="{StaticResource TinyLabel}"
                                       Text="{Binding ArgumentsLabel}"
                                       Visibility="{Binding IsNotFolder, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBox Margin="0,6,0,0"
                                     Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="{Binding IsNotFolder, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <StackPanel Margin="0,16,0,0" Orientation="Horizontal">
                                <Button Command="{Binding DataContext.TestActionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Style="{StaticResource PrimaryButton}"
                                        Content="Aksiyonu Test Et" />
                            </StackPanel>

                            <DockPanel Margin="0,18,0,8" LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource TinyLabel}"
                                           Text="İkon galerisi" />
                                <Button DockPanel.Dock="Right"
                                        Padding="10,5"
                                        Command="{Binding DataContext.ImportIconCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Content="PNG/SVG ekle" />
                            </DockPanel>
                            <ListBox MaxHeight="150"
                                     ItemContainerStyle="{StaticResource IconTileItem}"
                                     ItemTemplate="{StaticResource IconTileTemplate}"
                                     ItemsSource="{Binding DataContext.AvailableIcons, RelativeSource={RelativeSource AncestorType=Window}}"
                                     SelectedValue="{Binding Icon, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     SelectedValuePath="Key"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                            </ListBox>

                            <Border Margin="0,18,0,0"
                                    Style="{StaticResource SoftSurface}">
                                <TextBlock Foreground="#4B5563"
                                           TextWrapping="Wrap"
                                           Text="Kopyala, yapıştır, kes gibi işlemler için hazır eylem seçip Uygula demen yeterli. Gelişmiş ID normal kullanımda otomatik kalabilir." />
                            </Border>

                            <Border Margin="0,18,0,0"
                                    Style="{StaticResource SoftSurface}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{StaticResource TinyLabel}" Text="Aktif process" />
                                        <TextBlock Margin="0,5,0,0"
                                                   FontFamily="Consolas"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding DataContext.ActiveProcessName, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="14,0,14,0">
                                        <TextBlock Style="{StaticResource TinyLabel}" Text="Eşleşen profil" />
                                        <TextBlock Margin="0,5,0,0"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding DataContext.ActiveProfileName, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </StackPanel>
                                    <Button Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Command="{Binding DataContext.DetectProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Content="Algıla" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <DockPanel Grid.Row="4">
            <TextBlock DockPanel.Dock="Left"
                       VerticalAlignment="Center"
                       Style="{StaticResource MutedText}"
                       Text="{Binding StatusMessage}" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Command="{Binding ReloadConfigCommand}" Content="Yenile" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
