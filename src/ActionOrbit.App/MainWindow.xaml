<Window x:Class="ActionOrbit.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:actionViews="clr-namespace:ActionOrbit.App.Views.Actions"
        xmlns:settingsViews="clr-namespace:ActionOrbit.App.Views.Settings"
        xmlns:shelfViews="clr-namespace:ActionOrbit.App.Views.Shelf"
        Title="Action Orbit Pro"
        Icon="Assets/Brand/ActionOrbit.ico"
        Width="1180"
        Height="800"
        MinWidth="920"
        MinHeight="650"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        SourceInitialized="Window_SourceInitialized">
    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding Autosave.SaveNowCommand}" />
        <KeyBinding Key="D1" Modifiers="Control" Command="{Binding NavigateWorkspaceCommand}" CommandParameter="home" />
        <KeyBinding Key="D2" Modifiers="Control" Command="{Binding NavigateWorkspaceCommand}" CommandParameter="editor" />
        <KeyBinding Key="D3" Modifiers="Control" Command="{Binding NavigateWorkspaceCommand}" CommandParameter="library" />
        <KeyBinding Key="D4" Modifiers="Control" Command="{Binding NavigateWorkspaceCommand}" CommandParameter="shelf" />
        <KeyBinding Key="D5" Modifiers="Control" Command="{Binding NavigateWorkspaceCommand}" CommandParameter="settings" />
    </Window.InputBindings>
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        </Style>

        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="TinyLabel" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        </Style>

        <Style x:Key="Surface" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style x:Key="SoftSurface" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SoftSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12" />
        </Style>

        <Style x:Key="ButtonBase" TargetType="Button">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="13,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource PrimaryActionBrush}" />
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.015" ScaleY="1.015" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource PrimaryActionBrush}" />
                                <Setter TargetName="Shell" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" BasedOn="{StaticResource ButtonBase}" />

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Foreground" Value="{DynamicResource OnPrimaryActionBrush}" />
            <Setter Property="Background" Value="{DynamicResource PrimaryActionBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryActionBrush}" />
        </Style>

        <Style x:Key="SubtleButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Background" Value="{DynamicResource SoftSurfaceBrush}" />
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource DangerSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MaxDropDownHeight" Value="320" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle"
                                          MinHeight="{TemplateBinding MinHeight}"
                                          HorizontalContentAlignment="Stretch"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          ClickMode="Press"
                                          Focusable="False"
                                          Foreground="{TemplateBinding Foreground}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ComboShell"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="20" />
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1"
                                                      Width="8"
                                                      Height="5"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Data="M 0 0 L 4 4 L 8 0"
                                                      Stroke="{TemplateBinding Foreground}"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      StrokeThickness="1.5" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ComboShell" Property="BorderBrush" Value="{DynamicResource PrimaryActionBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="ComboShell" Property="BorderBrush" Value="{DynamicResource PrimaryActionBrush}" />
                                                <Setter TargetName="ComboShell" Property="BorderThickness" Value="2" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="ComboShell" Property="Opacity" Value="0.55" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="SelectionPresenter"
                                              Margin="10,0,30,0"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              IsHitTestVisible="False"
                                              RecognizesAccessKey="True"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />

                            <TextBox x:Name="PART_EditableTextBox"
                                     Margin="8,1,30,1"
                                     Padding="2,0"
                                     HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                     VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{TemplateBinding Foreground}"
                                     IsReadOnly="{TemplateBinding IsReadOnly}"
                                     Visibility="Hidden" />

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=DropDownToggle}"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, ElementName=DropDownToggle}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Margin="0,4,0,0"
                                        Padding="4"
                                        Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource InputBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <ScrollViewer CanContentScroll="True"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="SelectionPresenter" Property="Visibility" Value="Hidden" />
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="DropDownToggle" Property="BorderBrush" Value="{DynamicResource PrimaryActionBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemShell"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemShell" Property="Background" Value="{DynamicResource HoverSurfaceBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemShell" Property="Background" Value="{DynamicResource SelectedSurfaceBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>

        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style x:Key="CleanListBoxItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemShell"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="12">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemShell" Property="Background" Value="{DynamicResource HoverSurfaceBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemShell" Property="Background" Value="{DynamicResource SelectedSurfaceBrush}" />
                                <Setter TargetName="ItemShell" Property="BorderBrush" Value="{DynamicResource SelectedBorderBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                <Setter TargetName="ItemShell" Property="Background" Value="{DynamicResource InfoSurfaceBrush}" />
                                <Setter TargetName="ItemShell" Property="BorderBrush" Value="{DynamicResource InfoBorderBrush}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconTileItem" TargetType="ListBoxItem">
            <Setter Property="Width" Value="82" />
            <Setter Property="Height" Value="62" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="IconShell"
                                Padding="7"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="IconShell" Property="Background" Value="{DynamicResource HoverSurfaceBrush}" />
                                <Setter TargetName="IconShell" Property="BorderBrush" Value="{DynamicResource SelectedBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="IconShell" Property="Background" Value="{DynamicResource PrimaryActionBrush}" />
                                <Setter TargetName="IconShell" Property="BorderBrush" Value="{DynamicResource PrimaryActionBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource OnPrimaryActionBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="PresetTemplate">
            <Grid MinHeight="42">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="30"
                        Height="30"
                        Margin="0,0,10,0"
                        Background="{DynamicResource IconSurfaceBrush}"
                        CornerRadius="15">
                    <Grid>
                        <Image Width="17"
                               Height="17"
                               Source="{Binding ImagePath}"
                               Stretch="Uniform"
                               Visibility="{Binding HasImage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Viewbox Width="16"
                                 Height="16"
                                 Visibility="{Binding HasPaths, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid Width="24" Height="24">
                            <ItemsControl ItemsSource="{Binding IconPaths}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Grid />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Path Data="{Binding}"
                                              Fill="Transparent"
                                              Stroke="{DynamicResource PrimaryTextBrush}"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              StrokeStartLineCap="Round"
                                              StrokeThickness="2" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                        </Viewbox>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock FontWeight="SemiBold"
                               Text="{Binding Title}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Style="{StaticResource MutedText}"
                               Text="{Binding Description}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="IconTileTemplate">
            <StackPanel HorizontalAlignment="Center">
                <Image Width="22"
                       Height="22"
                       HorizontalAlignment="Center"
                       Source="{Binding ImagePath}"
                       Stretch="Uniform"
                       Visibility="{Binding HasImage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <Viewbox Width="20"
                         Height="20"
                         HorizontalAlignment="Center"
                         Visibility="{Binding HasPaths, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid Width="24" Height="24">
                        <ItemsControl ItemsSource="{Binding Paths}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Grid />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Path Data="{Binding}"
                                          Fill="Transparent"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeThickness="2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Viewbox>
                <TextBlock Margin="0,5,0,0"
                           HorizontalAlignment="Center"
                           FontSize="10"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                           Text="{Binding Label}"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ProfileTemplate">
            <Grid Margin="2" MinHeight="58">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="34"
                        Height="34"
                        Margin="10,0,10,0"
                        VerticalAlignment="Center"
                        Background="{DynamicResource PrimaryActionBrush}"
                        CornerRadius="17">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource OnPrimaryActionBrush}"
                               FontWeight="Bold"
                               Text="P" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock FontWeight="SemiBold"
                               Text="{Binding Name}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Margin="0,2,0,0"
                               Style="{StaticResource MutedText}"
                               Text="{Binding Id}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Margin="0,2,0,0"
                               Style="{StaticResource MutedText}"
                               Text="{Binding Matches.Count, StringFormat={}{0} uygulama bağlı}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ActionRowTemplate">
            <Grid Margin="2" MinHeight="48">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding Indent}" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0"
                      Visibility="{Binding IsChild, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border Width="2"
                            Margin="0,7,8,7"
                            HorizontalAlignment="Right"
                             Background="{DynamicResource SelectedBorderBrush}"
                            CornerRadius="2" />
                </Grid>

                <Border Grid.Column="1"
                        Width="36"
                        Height="36"
                        VerticalAlignment="Center"
                        Background="{DynamicResource IconSurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="18">
                    <Grid>
                        <Image Width="19"
                               Height="19"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Source="{Binding IconImagePath}"
                               Stretch="Uniform"
                               Visibility="{Binding HasIconImage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Viewbox Width="18"
                                 Height="18"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Visibility="{Binding HasIconPaths, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid Width="24" Height="24">
                                <ItemsControl ItemsSource="{Binding IconPaths}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Grid />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Path Data="{Binding}"
                                                  Fill="Transparent"
                                              Stroke="{DynamicResource PrimaryTextBrush}"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  StrokeStartLineCap="Round"
                                                  StrokeThickness="2" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Viewbox>
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe UI Symbol"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Text="{Binding DisplayIcon}"
                                   Visibility="{Binding HasFallbackIcon, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2" Margin="11,0,0,0" VerticalAlignment="Center">
                    <TextBlock FontWeight="SemiBold"
                               Text="{Binding Title}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Style="{StaticResource MutedText}"
                               Text="{Binding RowSubtitle}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Border Grid.Column="3"
                        Margin="8,0,8,0"
                        Padding="8,4"
                        VerticalAlignment="Center"
                        Background="{DynamicResource SoftSurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="999"
                        Visibility="{Binding IsFolder, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Text="klasör" />
                </Border>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <Image Width="58"
                       Height="58"
                       Margin="0,0,14,0"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Source="Assets/Brand/ActionOrbitLogo.png"
                       Stretch="Uniform" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="30"
                               FontWeight="Bold"
                               Text="Action Orbit Pro" />
                    <TextBlock Margin="0,5,0,0"
                               Style="{StaticResource MutedText}"
                               Text="Mouse makro tuşuna bağladığın hotkey ile imlecin yanında action ring açılır." />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <Border Margin="0,0,10,0"
                        Padding="12,8"
                        Background="{Binding Hotkey.HotkeyBadgeBackground}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="9"
                                 Height="9"
                                 Margin="0,0,9,0"
                                 VerticalAlignment="Center"
                                 Fill="{Binding Hotkey.HotkeyDotBrush}" />
                        <TextBlock Margin="0,0,8,0"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding Hotkey.HotkeyBadgeForeground}"
                                   Text="{Binding Hotkey.HotkeyStateText}" />
                        <TextBlock FontWeight="SemiBold"
                                   Foreground="{Binding Hotkey.HotkeyBadgeForeground}"
                                   Text="{Binding Hotkey.HotkeyDisplay}" />
                    </StackPanel>
                </Border>
                <Button Click="RunInBackground_Click"
                        Style="{StaticResource SubtleButton}"
                        Content="Arka planda çalıştır" />
                <Button Command="{Binding ShowOverlayCommand}"
                        Style="{StaticResource SubtleButton}"
                        Content="Önizle" />
                <Button Command="{Binding Shelf.OpenFloatingShelfCommand}"
                        Style="{StaticResource SubtleButton}"
                        Content="Yüzen Raf" />
                <Border Padding="11,8"
                        Background="{Binding Autosave.StateBackground}"
                        CornerRadius="10">
                    <TextBlock Foreground="{Binding Autosave.StateForeground}"
                               FontWeight="SemiBold"
                               Text="{Binding Autosave.StateText}" />
                </Border>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Margin="0,16,0,0"
                Padding="7"
                HorizontalAlignment="Left"
                Background="{DynamicResource NavigationBrush}"
                CornerRadius="14">
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding NavigateWorkspaceCommand}"
                        CommandParameter="home"
                        AutomationProperties.Name="Ana Sayfa, Ctrl+1"
                        ToolTip="Ana Sayfa · Ctrl+1"
                        Content="Ana Sayfa">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SubtleButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsHomeWorkspace}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource PrimaryActionBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource OnPrimaryActionBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryActionBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Command="{Binding NavigateWorkspaceCommand}"
                        CommandParameter="editor"
                        AutomationProperties.Name="Ring Editörü, Ctrl+2"
                        ToolTip="Ring Editörü · Ctrl+2"
                        Content="Ring Editörü">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SubtleButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditorWorkspace}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource PrimaryActionBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource OnPrimaryActionBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryActionBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Command="{Binding NavigateWorkspaceCommand}"
                        CommandParameter="library"
                        AutomationProperties.Name="Aksiyon Kütüphanesi, Ctrl+3"
                        ToolTip="Aksiyon Kütüphanesi · Ctrl+3"
                        Content="Aksiyon Kütüphanesi">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SubtleButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLibraryWorkspace}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource PrimaryActionBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource OnPrimaryActionBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryActionBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Command="{Binding NavigateWorkspaceCommand}"
                        CommandParameter="shelf"
                        AutomationProperties.Name="Orbit Shelf, Ctrl+4"
                        ToolTip="Geçici içerik rafı · Ctrl+4"
                        Content="Orbit Shelf">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SubtleButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsShelfWorkspace}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource PrimaryActionBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource OnPrimaryActionBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryActionBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Command="{Binding NavigateWorkspaceCommand}"
                        CommandParameter="settings"
                        AutomationProperties.Name="Ayarlar, Ctrl+5"
                        ToolTip="Ayarlar · Ctrl+5"
                        Content="Ayarlar">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SubtleButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSettingsWorkspace}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource PrimaryActionBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource OnPrimaryActionBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryActionBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Margin="0,16,0,0"
                Style="{StaticResource Surface}"
                Visibility="{Binding IsHomeWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Margin="0,0,10,0" Style="{StaticResource SoftSurface}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TinyLabel}" Text="GLOBAL HOTKEY" />
                            <TextBlock Margin="0,7,0,0"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Text="{Binding Hotkey.HotkeyDisplay}" />
                            <TextBlock Margin="0,4,0,0"
                                       Foreground="{Binding Hotkey.HotkeyBadgeForeground}"
                                       Text="{Binding Hotkey.HotkeyStateText}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Margin="5,0" Style="{StaticResource SoftSurface}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TinyLabel}" Text="AKTİF BAĞLAM" />
                            <TextBlock Margin="0,7,0,0"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Text="{Binding ProfileEditor.ActiveProfileName}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Margin="0,4,0,0"
                                       Style="{StaticResource MutedText}"
                                       Text="{Binding ProfileEditor.ActiveProcessName}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Margin="10,0,0,0" Style="{StaticResource SoftSurface}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource TinyLabel}" Text="ÇALIŞMA ALANI" />
                            <TextBlock Grid.Row="1"
                                       Margin="0,7,0,8"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Text="{Binding ProfileEditor.ProfileCount, StringFormat={}{0} profil hazır}" />
                            <WrapPanel Grid.Row="2">
                                <Button Command="{Binding NavigateWorkspaceCommand}"
                                        CommandParameter="editor"
                                        Content="Ring'i Düzenle" />
                                <Button Command="{Binding ShowOverlayCommand}"
                                        Content="Önizle" />
                            </WrapPanel>
                        </Grid>
                    </Border>
                </Grid>

            <Expander Margin="0,16,0,0"
                      Header="Kurulum, hotkey ve dosyalar"
                      IsExpanded="True">
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.35*" />
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock FontWeight="Bold" Text="İlk kurulum" />
                    <TextBlock Margin="0,5,14,0"
                               Style="{StaticResource MutedText}"
                               TextWrapping="Wrap"
                               Text="1. Mouse yazılımında makro tuşuna bu hotkey'i ata. 2. Önizle ile halkayı test et. 3. Aktif uygulamayı ilgili profile ekle." />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="12,0,14,0">
                    <TextBlock Style="{StaticResource TinyLabel}" Text="Hotkey" />
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Margin="0,0,8,0"
                                 Text="{Binding Hotkey.HotkeyInput, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1"
                                Command="{Binding Hotkey.SaveHotkeyCommand}"
                                Content="Kısayolu Kaydet" />
                    </Grid>
                    <TextBlock Margin="0,7,0,0"
                               Style="{StaticResource MutedText}"
                               Text="Örn: Ctrl+Alt+Shift+R, F13, F14, Ctrl+Space" />
                    <Border Margin="0,9,0,0"
                            Padding="10"
                            Background="{DynamicResource DangerSurfaceBrush}"
                            BorderBrush="{DynamicResource DangerBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Visibility="{Binding Hotkey.HasHotkeyIssue, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Foreground="{DynamicResource DangerTextBrush}"
                                       Text="{Binding Hotkey.HotkeyIssueMessage}"
                                       TextWrapping="Wrap" />
                            <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Hotkey.Suggestions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Margin="0,0,6,6"
                                                Padding="9,4"
                                                Command="{Binding DataContext.Hotkey.UseSuggestedHotkeyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Content="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            VerticalAlignment="Bottom"
                            Orientation="Horizontal">
                    <Button Command="{Binding Transfers.OpenConfigFolderCommand}" Content="Config Klasörü" />
                    <Button Command="{Binding Transfers.OpenConfigCommand}" Content="JSON Aç" />
                    <Button Command="{Binding Transfers.OpenLogCommand}" Content="Log Aç" />
                </StackPanel>
            </Grid>
            </Expander>
            </StackPanel>
        </Border>

        <shelfViews:ShelfWorkspaceView Grid.Row="2"
                                       Margin="0,12,0,16"
                                       DataContext="{Binding Shelf}"
                                       Visibility="{Binding IsShelfWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <settingsViews:SettingsView Grid.Row="2"
                                    Margin="0,12,0,0"
                                    Visibility="{Binding IsSettingsWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <actionViews:ActionLibraryView Grid.Row="2"
                                       Margin="0,12,0,16"
                                       Visibility="{Binding IsLibraryWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <actionViews:EditorWorkspaceView Grid.Row="2"
                                         Margin="0,12,0,16"
                                         Visibility="{Binding IsEditorWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <DockPanel Grid.Row="3">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Command="{Binding UndoCommand}"
                        Content="{Binding UndoButtonText}"
                        IsEnabled="{Binding CanUndo}" />
                <Button Command="{Binding Transfers.ReloadConfigCommand}" Content="Yenile" />
            </StackPanel>
            <Border Margin="0,0,12,0"
                    Padding="10,6"
                    VerticalAlignment="Center"
                    Background="{Binding Status.Background}"
                    CornerRadius="10">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7"
                             Height="7"
                             Margin="0,0,7,0"
                             VerticalAlignment="Center"
                             Fill="{Binding Status.DotBrush}" />
                    <TextBlock VerticalAlignment="Center"
                               Foreground="{Binding Status.Foreground}"
                               Text="{Binding Status.Message}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </DockPanel>
    </Grid>
</Window>
