<Window x:Class="ActionOrbit.App.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Action Orbit"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="Manual"
        SnapsToDevicePixels="True"
        Topmost="True"
        UseLayoutRounding="True"
        WindowStyle="None"
        PreviewKeyDown="Window_PreviewKeyDown"
        Deactivated="Window_Deactivated">
    <Window.Resources>
        <Style x:Key="OrbitButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="{Binding Diameter}" />
            <Setter Property="Height" Value="{Binding Diameter}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="#111318" />
            <Setter Property="Background" Value="#F2F2F2" />
            <Setter Property="BorderBrush" Value="#1F000000" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid ClipToBounds="False">
                            <Grid x:Name="ShapeLayer"
                                  ClipToBounds="False">
                                <Grid.Effect>
                                    <DropShadowEffect BlurRadius="17"
                                                      Opacity="0.25"
                                                      ShadowDepth="3"
                                                      Color="#000000" />
                                </Grid.Effect>

                                <Canvas Width="{Binding Diameter}"
                                        Height="{Binding Diameter}"
                                        ClipToBounds="False"
                                        IsHitTestVisible="False">
                                    <Ellipse x:Name="FolderLob"
                                             Width="{Binding FolderLobWidth}"
                                             Height="{Binding FolderLobHeight}"
                                             Canvas.Left="{Binding FolderLobX}"
                                             Canvas.Top="{Binding FolderLobY}"
                                             Fill="{TemplateBinding Background}"
                                             Stroke="Transparent"
                                             StrokeThickness="0"
                                             RenderTransformOrigin="0.5,0.5"
                                             Visibility="Collapsed">
                                        <Ellipse.RenderTransform>
                                            <RotateTransform Angle="{Binding FolderLobAngle}" />
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                </Canvas>

                                <Border x:Name="Shell"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="999"
                                        SnapsToDevicePixels="True" />
                            </Grid>

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding DataContext.ShowFolderLob, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                <Setter TargetName="FolderLob" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Shell" Property="BorderBrush" Value="Transparent" />
                                <Setter TargetName="Shell" Property="BorderThickness" Value="0" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSatellite}" Value="True">
                                <Setter Property="Background" Value="#F6F6F6" />
                                <Setter Property="Foreground" Value="#17191D" />
                                <Setter Property="BorderBrush" Value="#26000000" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsActiveFolder}" Value="True">
                                <Setter Property="Background" Value="#15171D" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter Property="BorderBrush" Value="#6615171D" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsKeyboardSelected}" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="{Binding DataContext.AccentBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                                <Setter TargetName="FolderLob" Property="Fill" Value="{Binding DataContext.AccentBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                                <Setter Property="Foreground" Value="{Binding DataContext.AccentForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                                <Setter Property="BorderBrush" Value="{Binding DataContext.AccentForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="#FFFFFF" />
                                <Setter TargetName="FolderLob" Property="Fill" Value="#FFFFFF" />
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.04" ScaleY="1.04" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsActiveFolder}" Value="True" />
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Shell" Property="Background" Value="#111318" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter Property="BorderBrush" Value="#5A111318" />
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsKeyboardSelected}" Value="True" />
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Shell" Property="Background" Value="{Binding DataContext.AccentBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                                <Setter TargetName="FolderLob" Property="Fill" Value="{Binding DataContext.AccentBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                                <Setter Property="Foreground" Value="{Binding DataContext.AccentForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                                <Setter Property="BorderBrush" Value="{Binding DataContext.AccentForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                            </MultiDataTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CenterButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#30FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="17">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="22"
                                                  Opacity="0.36"
                                                  ShadowDepth="3"
                                                  Color="#000000" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Shell" Property="Opacity" Value="0.76" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OverlayInfoButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#30FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Shell" Property="Opacity" Value="0.78" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="OrbitButtonTemplate">
            <Button Style="{StaticResource OrbitButtonStyle}"
                    AutomationProperties.Name="{Binding Title}"
                    AutomationProperties.HelpText="{Binding ToolTipText}"
                    Command="{Binding Command}"
                    CommandParameter="{Binding}"
                    ToolTip="{Binding ToolTipText}"
                    ToolTipService.BetweenShowDelay="0"
                    ToolTipService.InitialShowDelay="180"
                    ToolTipService.Placement="Top"
                    ToolTipService.ShowDuration="1400">
                <Grid Width="{Binding Diameter}"
                      Height="{Binding Diameter}"
                      ClipToBounds="False">
                    <Image Width="{Binding IconFontSize}"
                           Height="{Binding IconFontSize}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Source="{Binding EffectiveIconImagePath}"
                           Stretch="Uniform"
                           Visibility="{Binding HasEffectiveIconImage, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <Viewbox Width="{Binding IconFontSize}"
                             Height="{Binding IconFontSize}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Visibility="{Binding HasEffectiveIconPaths, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid Width="24" Height="24">
                            <ItemsControl ItemsSource="{Binding EffectiveIconPaths}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Grid />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Path Data="{Binding}"
                                              Fill="Transparent"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              StrokeStartLineCap="Round"
                                              StrokeThickness="2" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Viewbox>

                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontFamily="Segoe UI Symbol"
                               FontSize="{Binding IconFontSize}"
                               FontWeight="SemiBold"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                               Text="{Binding EffectiveIcon}"
                               TextAlignment="Center"
                               Visibility="{Binding HasEffectiveFallbackIcon, Converter={StaticResource BooleanToVisibilityConverter}}" />

                </Grid>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Canvas x:Name="RootCanvas"
            Background="#01000000"
            MouseDown="RootCanvas_MouseDown">
        <ItemsControl ItemTemplate="{StaticResource OrbitButtonTemplate}"
                      ItemsSource="{Binding ActionItems}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{Binding X}" />
                    <Setter Property="Canvas.Top" Value="{Binding Y}" />
                </Style>
            </ItemsControl.ItemContainerStyle>
        </ItemsControl>

        <ItemsControl ItemTemplate="{StaticResource OrbitButtonTemplate}"
                      ItemsSource="{Binding SatelliteItems}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{Binding X}" />
                    <Setter Property="Canvas.Top" Value="{Binding Y}" />
                </Style>
            </ItemsControl.ItemContainerStyle>
        </ItemsControl>

        <Border Canvas.Left="{Binding OverlayInfoLeft}"
                Canvas.Top="{Binding OverlayInfoTop}"
                Width="264"
                Padding="12,8"
                Background="{Binding OverlayInfoBackground}"
                BorderBrush="#2A000000"
                BorderThickness="1"
                CornerRadius="14">
            <StackPanel>
                <TextBlock HorizontalAlignment="Center"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="{Binding OverlayInfoForeground}"
                           Text="{Binding ProfileName}"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Margin="0,2,0,0"
                           HorizontalAlignment="Center"
                           FontSize="11"
                           Foreground="{Binding OverlayInfoMutedForeground}"
                           Text="{Binding FolderStatusText}"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Margin="0,3,0,0"
                           HorizontalAlignment="Center"
                           FontSize="9"
                           Foreground="{Binding OverlayInfoMutedForeground}"
                           Text="{Binding KeyboardHint}"
                           TextAlignment="Center" />
                <TextBlock Margin="0,2,0,0"
                           HorizontalAlignment="Center"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="{Binding OverlayInfoMutedForeground}"
                           Text="{Binding FolderOverflowText}"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Visibility="{Binding HasFolderOverflow, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <Button Margin="0,7,0,0"
                        HorizontalAlignment="Center"
                        Background="{Binding AccentBrush}"
                        Foreground="{Binding AccentForegroundBrush}"
                        Command="{Binding CollapseFolderCommand}"
                        Content="Geri"
                        Style="{StaticResource OverlayInfoButtonStyle}"
                        Visibility="{Binding CanCollapseFolder, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
        </Border>

        <Button Style="{StaticResource CenterButtonStyle}"
                Canvas.Left="{Binding CenterX}"
                Canvas.Top="{Binding CenterY}"
                Background="{Binding AccentBrush}"
                Foreground="{Binding AccentForegroundBrush}"
                Command="{Binding ToggleDefaultProfileCommand}"
                ToolTip="{Binding CenterButtonToolTip}"
                ToolTipService.BetweenShowDelay="0"
                ToolTipService.InitialShowDelay="180"
                ToolTipService.Placement="Top"
                ToolTipService.ShowDuration="1400">
            <Button.RenderTransform>
                <TranslateTransform X="-17" Y="-17" />
            </Button.RenderTransform>
            <TextBlock FontFamily="Segoe UI Symbol"
                       FontSize="15"
                       FontWeight="Bold"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                       Text="{Binding CenterButtonText}"
                       TextAlignment="Center" />
        </Button>

        <Border Canvas.Left="{Binding CenterHintLeft}"
                Canvas.Top="{Binding CenterHintTop}"
                Width="92"
                Padding="6,3"
                Background="{Binding CenterHintBackground}"
                CornerRadius="10">
            <TextBlock FontSize="10"
                       FontWeight="SemiBold"
                       Foreground="{Binding CenterHintForeground}"
                       Text="{Binding CenterButtonHint}"
                       TextAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
        </Border>

    </Canvas>
</Window>
