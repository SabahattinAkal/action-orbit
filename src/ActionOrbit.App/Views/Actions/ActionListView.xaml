<UserControl x:Class="ActionOrbit.App.Views.Actions.ActionListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:actionViews="clr-namespace:ActionOrbit.App.Views.Actions"
             DataContext="{Binding ActionEditor}"
             AutomationProperties.Name="Aksiyon listesi">
    <UserControl.Resources>
        <Style x:Key="ActionPanelListItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemShell"
                                Padding="8,5"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemShell" Property="Background" Value="{DynamicResource HoverSurfaceBrush}" />
                                <Setter TargetName="ItemShell" Property="BorderBrush" Value="{DynamicResource SelectedBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemShell" Property="Background" Value="{DynamicResource SelectedSurfaceBrush}" />
                                <Setter TargetName="ItemShell" Property="BorderBrush" Value="{DynamicResource PrimaryActionBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                <Setter TargetName="ItemShell" Property="Background" Value="{DynamicResource InfoSurfaceBrush}" />
                                <Setter TargetName="ItemShell" Property="BorderBrush" Value="{DynamicResource InfoBorderBrush}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Style="{DynamicResource Surface}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="18" FontWeight="Bold" Text="2. Aksiyonlar" />
                    <TextBlock Margin="0,4,12,0"
                               Style="{DynamicResource MutedText}"
                               Text="Halkadaki düğmeleri ekle, seç ve sırala."
                               TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Margin="12,2,0,0"
                           VerticalAlignment="Top"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Text="{Binding ActionRows.Count, StringFormat={}{0} aksiyon}" />
            </Grid>

            <Border Grid.Row="1"
                    Margin="0,14,0,0"
                    Padding="12"
                    Background="{DynamicResource SoftSurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    DataContext="{Binding DataContext.RingSets, RelativeSource={RelativeSource AncestorType=Window}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" LastChildFill="True">
                        <TextBlock DockPanel.Dock="Left"
                                   Style="{DynamicResource TinyLabel}"
                                   Text="HALKA DÜZENİ" />
                        <TextBlock HorizontalAlignment="Right"
                                   Style="{DynamicResource MutedText}"
                                   Text="{Binding SelectedRing.DisplayName}"
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <ComboBox Grid.Row="1"
                              Margin="0,8,0,0"
                              AutomationProperties.Name="Düzenlenen halka"
                              DisplayMemberPath="DisplayName"
                              ItemsSource="{Binding Rings}"
                              SelectedItem="{Binding SelectedRing}" />
                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Margin="0,0,8,0"
                                 AutomationProperties.Name="Halka adı"
                                 ToolTip="Aktif halka setinin adı"
                                 Text="{Binding SelectedRingName, UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button MinHeight="34"
                                    Padding="9,5"
                                    Command="{Binding AddRingCommand}"
                                    Content="Yeni" />
                            <Button MinHeight="34"
                                    Padding="9,5"
                                    Command="{Binding DuplicateRingCommand}"
                                    Content="Kopyala" />
                            <Button MinHeight="34"
                                    Margin="0"
                                    Padding="9,5"
                                    Command="{Binding DeleteRingCommand}"
                                    Content="Sil"
                                    IsEnabled="{Binding CanDeleteSelectedRing}"
                                    Style="{DynamicResource DangerButton}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="0,12,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button Command="{Binding AddActionCommand}"
                            Content="+ Aksiyon"
                            Style="{DynamicResource PrimaryButton}" />
                    <Button Command="{Binding AddFolderCommand}"
                            Content="+ Klasör" />
                    <Button Margin="0"
                            Command="{Binding AddChildActionCommand}"
                            Content="+ Alt aksiyon"
                            IsEnabled="{Binding SelectedActionIsFolder}"
                            ToolTip="Seçili klasöre yeni bir alt aksiyon ekle" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="3"
                    Padding="10"
                    Background="{DynamicResource SoftSurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="2,0,2,8">
                        <TextBlock DockPanel.Dock="Left"
                                   FontWeight="SemiBold"
                                   Text="Halka aksiyonları" />
                        <TextBlock HorizontalAlignment="Right"
                                   Style="{DynamicResource MutedText}"
                                   Text="Sürükleyerek sırala" />
                    </DockPanel>
                    <ListBox x:Name="ActionList"
                             Grid.Row="1"
                             Padding="0,0,4,0"
                             AllowDrop="True"
                             ItemsSource="{Binding ActionRows}"
                             SelectedItem="{Binding SelectedAction}"
                             ItemTemplate="{DynamicResource ActionRowTemplate}"
                             ItemContainerStyle="{StaticResource ActionPanelListItem}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             PreviewMouseLeftButtonDown="ActionList_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="ActionList_PreviewMouseMove"
                             DragOver="ActionList_DragOver"
                             DragLeave="ActionList_DragLeave"
                             Drop="ActionList_Drop" />
                </Grid>
            </Border>

            <actionViews:RingPreviewView Grid.Row="4" Margin="0,10,0,0" />

            <Border Grid.Row="5"
                    Margin="0,10,0,0"
                    Padding="10"
                    Background="{DynamicResource SoftSurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Visibility="{Binding HasSelectedAction, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontWeight="SemiBold"
                                   Text="{Binding SelectedAction.Title}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Margin="0,2,8,0"
                                   Style="{DynamicResource MutedText}"
                                   Text="Seçili aksiyon"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button MinHeight="32"
                                Padding="9,5"
                                Command="{Binding MoveActionUpCommand}"
                                Content="←"
                                ToolTip="Önceki konuma taşı" />
                        <Button MinHeight="32"
                                Padding="9,5"
                                Command="{Binding MoveActionDownCommand}"
                                Content="→"
                                ToolTip="Sonraki konuma taşı" />
                        <Button MinHeight="32"
                                Margin="0"
                                Padding="9,5"
                                Command="{Binding MoveActionOutOfFolderCommand}"
                                Content="Dışarı al"
                                IsEnabled="{Binding CanMoveSelectedActionOutOfFolder}"
                                ToolTip="Aksiyonu klasörden ana halkaya çıkar" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
