<UserControl x:Class="ActionOrbit.App.Views.Actions.ActionLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Aksiyon Kütüphanesi">
    <UserControl.Resources>
        <Style x:Key="LibraryCardItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card"
                                MinHeight="78"
                                Padding="12"
                                Background="{DynamicResource SoftSurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource HoverSurfaceBrush}" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource SelectedBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource SelectedSurfaceBrush}" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource PrimaryActionBrush}" />
                                <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="LibraryPresetCard">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="38"
                        Height="38"
                        Margin="0,0,11,0"
                        VerticalAlignment="Center"
                        Background="{DynamicResource IconSurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="19">
                    <Grid>
                        <Image Width="20"
                               Height="20"
                               Source="{Binding ImagePath}"
                               Stretch="Uniform"
                               Visibility="{Binding HasImage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Viewbox Width="19"
                                 Height="19"
                                 Visibility="{Binding HasPaths, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid Width="24" Height="24">
                                <ItemsControl ItemsSource="{Binding IconPaths}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><Grid /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Path Data="{Binding}"
                                                  Fill="Transparent"
                                                  Stroke="{DynamicResource PrimaryTextBrush}"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  StrokeStartLineCap="Round"
                                                  StrokeThickness="2" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Viewbox>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Text="{Binding Title}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Margin="0,3,8,0"
                               FontSize="11"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Text="{Binding Description}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="2"
                           Margin="8,1,0,0"
                           VerticalAlignment="Top"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Text="{Binding TypeLabel}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Border Style="{DynamicResource Surface}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock FontSize="22" FontWeight="Bold" Text="Aksiyon Kütüphanesi" />
                <TextBlock Margin="0,5,0,0"
                           Style="{DynamicResource MutedText}"
                           Text="Sık kullanılan işlemleri sıfırdan ayarlamak yerine hazır bir şablondan ekle."
                           TextWrapping="Wrap" />
            </StackPanel>

            <Border Grid.Row="1"
                    Margin="0,14,0,0"
                    Padding="12"
                    Background="{DynamicResource SoftSurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="2,0,16,0">
                        <TextBlock FontWeight="Bold" Foreground="{DynamicResource PrimaryActionBrush}" Text="1 · Şablonu seç" />
                        <TextBlock Margin="0,3,0,0"
                                   Style="{DynamicResource MutedText}"
                                   Text="Kopyala, uygulama aç veya mini araç gibi hazır bir işlem seç."
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="{DynamicResource BorderBrush}" />
                    <StackPanel Grid.Column="2" Margin="16,0">
                        <TextBlock FontWeight="Bold" Foreground="{DynamicResource PrimaryActionBrush}" Text="2 · Hedefi belirle" />
                        <TextBlock Margin="0,3,0,0"
                                   Style="{DynamicResource MutedText}"
                                   Text="Yeni aksiyon için profilini veya düzenlenecek mevcut aksiyonu kullan."
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Grid.Column="3" Background="{DynamicResource BorderBrush}" />
                    <StackPanel Grid.Column="4" Margin="16,0,2,0">
                        <TextBlock FontWeight="Bold" Foreground="{DynamicResource PrimaryActionBrush}" Text="3 · Ekle veya uygula" />
                        <TextBlock Margin="0,3,0,0"
                                   Style="{DynamicResource MutedText}"
                                   Text="Profile yeni düğme ekle ya da seçili aksiyonun ayarlarını değiştir."
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.35*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Style="{DynamicResource TinyLabel}" Text="ARA" />
                    <TextBox Margin="0,6,0,0"
                             AutomationProperties.Name="Aksiyonlarda ara"
                             Text="{Binding ActionLibrarySearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Başlık, açıklama veya hedefte ara" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Style="{DynamicResource TinyLabel}" Text="KATEGORİ" />
                    <ComboBox Margin="0,6,0,0"
                              AutomationProperties.Name="Aksiyon kategorisi"
                              DisplayMemberPath="Label"
                              ItemsSource="{Binding ActionLibraryCategories}"
                              SelectedItem="{Binding SelectedActionLibraryCategory}" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="3"
                    Margin="0,14,0,12"
                    Padding="10,10,0,0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <ListBox Background="Transparent"
                         BorderThickness="0"
                         ItemContainerStyle="{StaticResource LibraryCardItem}"
                         ItemTemplate="{StaticResource LibraryPresetCard}"
                         ItemsSource="{Binding FilteredActionPresets}"
                         SelectedItem="{Binding ActionEditor.SelectedPreset}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
            </Border>

            <Border Grid.Row="4"
                    Padding="12"
                    Background="{DynamicResource SoftSurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,18,0">
                        <TextBlock Style="{DynamicResource TinyLabel}" Text="SEÇİLİ ŞABLON" />
                        <TextBlock Margin="0,4,0,0"
                                   FontWeight="SemiBold"
                                   Text="{Binding ActionEditor.SelectedPreset.Title}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Margin="0,3,0,0"
                                   Style="{DynamicResource MutedText}"
                                   Text="{Binding ProfileEditor.SelectedProfile.Name, StringFormat=Yeni aksiyon hedefi: {0} profili}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                        <Button Command="{Binding ActionEditor.AddPresetToProfileCommand}"
                                Content="Profile yeni aksiyon ekle"
                                Style="{DynamicResource PrimaryButton}"
                                ToolTip="Seçili şablonu hedef profilin ana halkasına yeni aksiyon olarak ekler" />
                        <Button Margin="0"
                                Command="{Binding ActionEditor.ApplyPresetCommand}"
                                Content="Seçili aksiyona uygula"
                                IsEnabled="{Binding ActionEditor.HasSelectedAction}"
                                ToolTip="Ring Editörü'nde seçili olan aksiyonun ayarlarını bu şablonla değiştirir" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
