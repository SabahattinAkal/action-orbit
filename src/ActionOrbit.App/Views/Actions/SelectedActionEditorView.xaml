<UserControl x:Class="ActionOrbit.App.Views.Actions.SelectedActionEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             DataContext="{Binding ActionEditor}"
             AutomationProperties.Name="Seçili aksiyon düzenleyicisi">
    <Border Style="{DynamicResource Surface}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="18" FontWeight="Bold" Text="3. Seçili Aksiyon" />
                    <TextBlock Margin="0,4,12,0"
                               Style="{DynamicResource MutedText}"
                               Text="Davranışı, hedefi ve görünümü tek yerden düzenle."
                               TextWrapping="Wrap" />
                </StackPanel>
                <Border Grid.Column="1"
                        MaxWidth="180"
                        Padding="10,5"
                        VerticalAlignment="Top"
                        Background="{DynamicResource SelectedSurfaceBrush}"
                        BorderBrush="{DynamicResource SelectedBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="999"
                        Visibility="{Binding HasSelectedAction, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Text="{Binding SelectedAction.Title}"
                               TextTrimming="CharacterEllipsis" />
                </Border>
            </Grid>

            <Border Grid.Row="1"
                    Margin="0,16,0,0"
                    Padding="18"
                    Background="{DynamicResource SoftSurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Visibility="{Binding HasNoSelectedAction, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="46"
                            Height="46"
                            HorizontalAlignment="Center"
                            Background="{DynamicResource IconSurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="23">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="20"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Text="＋" />
                    </Border>
                    <TextBlock Margin="0,12,0,0"
                               HorizontalAlignment="Center"
                               FontSize="16"
                               FontWeight="Bold"
                               Text="Bir aksiyon seç" />
                    <TextBlock MaxWidth="320"
                               Margin="0,6,0,0"
                               HorizontalAlignment="Center"
                               Style="{DynamicResource MutedText}"
                               Text="Soldaki listeden bir aksiyon seçtiğinde düzenleme alanları burada açılır."
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1"
                          Margin="0,16,0,0"
                          Padding="0,0,5,0"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding HasSelectedAction, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel DataContext="{Binding SelectedAction}">
                    <Border Padding="12"
                            Background="{DynamicResource SoftSurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                        <Grid DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="Hazır eylem" />
                                <TextBlock Margin="0,2,12,0"
                                           Style="{DynamicResource MutedText}"
                                           Text="Seçili aksiyona hazır bir davranış uygula."
                                           TextWrapping="Wrap" />
                                <ComboBox Margin="0,8,10,0"
                                          AutomationProperties.Name="Hazır eylem"
                                          ItemTemplate="{DynamicResource PresetTemplate}"
                                          ItemsSource="{Binding ActionEditor.ActionPresets}"
                                          SelectedItem="{Binding ActionEditor.SelectedPreset}" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Margin="0"
                                    VerticalAlignment="Bottom"
                                    Command="{Binding ActionEditor.ApplyPresetCommand}"
                                    Content="Uygula"
                                    Style="{DynamicResource PrimaryButton}" />
                        </Grid>
                    </Border>

                    <Border Margin="0,12,0,0"
                            Padding="14"
                            Background="{DynamicResource SoftSurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource TinyLabel}" Text="TEMEL BİLGİLER" />

                            <TextBlock Margin="0,12,0,0"
                                       Style="{DynamicResource TinyLabel}"
                                       Text="Ad" />
                            <TextBox Margin="0,6,0,0"
                                     AutomationProperties.Name="Aksiyon adı"
                                     Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />

                            <Border Margin="0,12,0,0"
                                    Padding="10"
                                    Background="{DynamicResource InfoSurfaceBrush}"
                                    BorderBrush="{DynamicResource InfoBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    Visibility="{Binding IsFolder, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border MinWidth="42"
                                            Padding="8,4"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource SurfaceBrush}"
                                            CornerRadius="999">
                                        <TextBlock HorizontalAlignment="Center"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource InfoTextBrush}"
                                                   Text="{Binding FolderBadgeText}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock FontWeight="SemiBold"
                                                   Foreground="{DynamicResource InfoTextBrush}"
                                                   Text="Alt aksiyon" />
                                        <TextBlock Margin="0,2,0,0"
                                                   Style="{DynamicResource MutedText}"
                                                   Text="Soldaki Alt aksiyon düğmesiyle bu klasöre içerik ekleyebilirsin."
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Margin="0,12,0,0"
                                    Padding="10"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    Visibility="{Binding IsChild, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Style="{DynamicResource MutedText}"
                                           Text="{Binding ParentTitle, StringFormat={}{0} klasörünün içinde}"
                                           TextWrapping="Wrap" />
                            </Border>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{DynamicResource TinyLabel}" Text="Eylem türü" />
                                    <ComboBox Margin="0,6,10,0"
                                              AutomationProperties.Name="Eylem türü"
                                              DisplayMemberPath="Label"
                                              IsEnabled="{Binding CanChangeType}"
                                              ItemsSource="{Binding DataContext.ActionEditor.ActionTypeOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedValue="{Binding Type, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="Key"
                                              ToolTip="Alt aksiyonları olan bir klasörün türünü değiştirmek için önce içeriğini taşı veya sil." />
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            Visibility="{Binding IsNotFolder, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Style="{DynamicResource TinyLabel}" Text="{Binding TargetLabel}" />
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 MinHeight="{Binding TargetBoxMinHeight}"
                                                 AcceptsReturn="True"
                                                 AutomationProperties.Name="Aksiyon hedefi"
                                                 IsEnabled="{Binding IsTargetEditable}"
                                                 Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}"
                                                 TextWrapping="Wrap" />
                                        <Button Grid.Column="1"
                                                Margin="8,0,0,0"
                                                Command="{Binding DataContext.ActionEditor.BrowseActionTargetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Content="Gözat"
                                                Visibility="{Binding DataContext.ActionEditor.CanBrowseSelectedAction, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <TextBlock Margin="0,7,0,0"
                                       Style="{DynamicResource MutedText}"
                                       Text="{Binding TypeHelp}"
                                       TextWrapping="Wrap" />

                            <StackPanel Margin="0,14,0,0"
                                        Visibility="{Binding IsNotFolder, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Style="{DynamicResource TinyLabel}" Text="{Binding ArgumentsLabel}" />
                                <TextBox Margin="0,6,0,0"
                                         AutomationProperties.Name="Ek bilgi"
                                         Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <Border Margin="0,12,0,0"
                                    Padding="10"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    Visibility="{Binding IsOpenUrl, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Style="{DynamicResource TinyLabel}" Text="Hedef tarayıcı" />
                                    <ComboBox Margin="0,6,0,0"
                                              AutomationProperties.Name="Hedef tarayıcı"
                                              DisplayMemberPath="Label"
                                              ItemsSource="{Binding DataContext.ActionEditor.BrowserOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedValue="{Binding Browser, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="Key" />
                                </StackPanel>
                            </Border>

                            <Border Margin="0,12,0,0"
                                    Padding="10"
                                    Background="{DynamicResource WarningSurfaceBrush}"
                                    BorderBrush="{DynamicResource WarningBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    Visibility="{Binding IsRunCommand, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Foreground="{DynamicResource WarningTextBrush}"
                                           Text="Yalnızca güvendiğin komutları çalıştır."
                                           TextWrapping="Wrap" />
                            </Border>

                            <Border Margin="0,12,0,0"
                                    Padding="10"
                                    Background="{DynamicResource DangerSurfaceBrush}"
                                    BorderBrush="{DynamicResource DangerBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Visibility="{Binding ActionEditor.HasSelectedActionValidation, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Foreground="{DynamicResource DangerTextBrush}"
                                           Text="{Binding ActionEditor.SelectedActionValidationMessage}"
                                           TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <Expander Margin="0,12,0,0"
                              Header="Doğrudan kısayol · isteğe bağlı"
                              IsExpanded="False"
                              Visibility="{Binding IsNotFolder, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Border Margin="0,8,0,0"
                                Padding="12"
                                Background="{DynamicResource SoftSurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                            <StackPanel>
                                <TextBox AutomationProperties.Name="Doğrudan aksiyon kısayolu"
                                         ToolTip="Örn: Ctrl+Alt+D veya F14"
                                         Text="{Binding Shortcut, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="0,6,0,0"
                                           Style="{DynamicResource MutedText}"
                                           Text="Bu kısayol aksiyonu halka açılmadan çalıştırır; aynı profilde benzersiz olmalıdır."
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Expander>

                    <Expander Margin="0,12,0,8" IsExpanded="False">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontWeight="SemiBold" Text="İkon seç" />
                                <TextBlock Margin="8,0,0,0"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           Text="{Binding Icon, StringFormat=· {0}}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Expander.Header>
                        <Border Margin="0,8,0,0"
                                Padding="12"
                                Background="{DynamicResource SoftSurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10" LastChildFill="True">
                                    <Button DockPanel.Dock="Right"
                                            Margin="10,0,0,0"
                                            Padding="10,5"
                                            Command="{Binding DataContext.ActionEditor.ImportIconCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Content="PNG/SVG ekle" />
                                    <TextBlock VerticalAlignment="Center"
                                               Style="{DynamicResource MutedText}"
                                               Text="Galeriden seç veya kendi ikonunu ekle."
                                               TextWrapping="Wrap" />
                                </DockPanel>
                                <ListBox MaxHeight="230"
                                         AutomationProperties.Name="İkon galerisi"
                                         ItemContainerStyle="{DynamicResource IconTileItem}"
                                         ItemTemplate="{DynamicResource IconTileTemplate}"
                                         ItemsSource="{Binding DataContext.ActionEditor.AvailableIcons, RelativeSource={RelativeSource AncestorType=Window}}"
                                         SelectedValue="{Binding Icon, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         SelectedValuePath="Key"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                </ListBox>
                            </StackPanel>
                        </Border>
                    </Expander>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Margin="0,12,0,0"
                    Padding="10"
                    Background="{DynamicResource SoftSurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Visibility="{Binding HasSelectedAction, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Margin="0"
                            HorizontalAlignment="Left"
                            Command="{Binding TestActionCommand}"
                            Content="Aksiyonu test et"
                            IsEnabled="{Binding CanTestSelectedAction}"
                            Style="{DynamicResource PrimaryButton}" />
                    <Button Grid.Column="1"
                            Margin="0"
                            Command="{Binding DeleteActionCommand}"
                            Content="Aksiyonu sil"
                            Style="{DynamicResource DangerButton}" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
