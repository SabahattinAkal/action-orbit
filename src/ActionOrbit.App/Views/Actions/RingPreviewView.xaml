<UserControl x:Class="ActionOrbit.App.Views.Actions.RingPreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Canlı halka önizlemesi">
    <Expander Header="Canlı halka önizlemesi"
              IsExpanded="True">
        <Border Margin="0,8,0,0" Style="{DynamicResource SoftSurface}">
            <StackPanel>
                <TextBlock Margin="0,0,0,6"
                           HorizontalAlignment="Center"
                           Style="{DynamicResource MutedText}"
                           Text="{Binding RingPreviewSummary}" />
                <Canvas Width="232"
                        Height="232"
                        HorizontalAlignment="Center">
                    <Border Canvas.Left="87"
                            Canvas.Top="87"
                            Width="58"
                            Height="58"
                            Background="{DynamicResource PrimaryActionBrush}"
                            CornerRadius="29">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource OnPrimaryActionBrush}"
                                       Text="AO" />
                            <TextBlock HorizontalAlignment="Center"
                                       FontSize="8"
                                       Foreground="{DynamicResource OnPrimaryActionBrush}"
                                       Opacity="0.74"
                                       Text="MERKEZ" />
                        </StackPanel>
                    </Border>

                    <ItemsControl Width="232"
                                  Height="232"
                                  ItemsSource="{Binding RingPreviewSlots}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                <Setter Property="Canvas.Top" Value="{Binding Top}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="58"
                                        Height="58"
                                        Padding="0"
                                        Margin="0"
                                        AllowDrop="True"
                                        AutomationProperties.Name="{Binding Title}"
                                        AutomationProperties.HelpText="Sıralamak için sürükle veya Alt+Sol/Sağ kullan."
                                        Command="{Binding DataContext.ActionEditor.SelectRingPreviewSlotCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        PreviewMouseLeftButtonDown="RingSlot_PreviewMouseLeftButtonDown"
                                        PreviewMouseMove="RingSlot_PreviewMouseMove"
                                        DragOver="RingSlot_DragOver"
                                        Drop="RingSlot_Drop"
                                        KeyDown="RingSlot_KeyDown">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource SelectedBorderBrush}" />
                                            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                                            <Setter Property="RenderTransform">
                                                <Setter.Value>
                                                    <ScaleTransform ScaleX="1" ScaleY="1" />
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="RingShell"
                                                                Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="29">
                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="RingShell" Property="BorderBrush" Value="{DynamicResource PrimaryActionBrush}" />
                                                                <Setter Property="RenderTransform">
                                                                    <Setter.Value>
                                                                        <ScaleTransform ScaleX="1.04" ScaleY="1.04" />
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Trigger>
                                                            <Trigger Property="IsPressed" Value="True">
                                                                <Setter Property="RenderTransform">
                                                                    <Setter.Value>
                                                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Trigger>
                                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                                <Setter TargetName="RingShell" Property="BorderBrush" Value="{DynamicResource PrimaryActionBrush}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource PrimaryActionBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryActionBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource OnPrimaryActionBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Button.ToolTip>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                            <TextBlock Margin="0,3,0,0" Text="Sürükleyerek sırala · Alt+←/→" />
                                        </StackPanel>
                                    </Button.ToolTip>
                                    <Grid>
                                        <Image Width="22"
                                               Height="22"
                                               Source="{Binding ImagePath}"
                                               Stretch="Uniform"
                                               Visibility="{Binding HasImage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <Viewbox Width="22"
                                                 Height="22"
                                                 Visibility="{Binding HasPaths, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Grid Width="24" Height="24">
                                                <ItemsControl ItemsSource="{Binding IconPaths}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><Grid /></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Path Data="{Binding}"
                                                                  Fill="Transparent"
                                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                  StrokeEndLineCap="Round"
                                                                  StrokeLineJoin="Round"
                                                                  StrokeStartLineCap="Round"
                                                                  StrokeThickness="2" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </Viewbox>
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontWeight="Bold"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                   Text="{Binding FallbackText}"
                                                   Visibility="{Binding HasFallback, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Canvas>

                <StackPanel Margin="0,10,0,0"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">
                    <Button MinHeight="30"
                            Padding="10,5"
                            Command="{Binding MoveActionUpCommand}"
                            Content="← Önceki"
                            ToolTip="Seçili aksiyonu halkada önceki konuma taşı" />
                    <Button MinHeight="30"
                            Margin="0"
                            Padding="10,5"
                            Command="{Binding MoveActionDownCommand}"
                            Content="Sonraki →"
                            ToolTip="Seçili aksiyonu halkada sonraki konuma taşı" />
                </StackPanel>
                <TextBlock Margin="0,6,0,0"
                           HorizontalAlignment="Center"
                           Style="{DynamicResource MutedText}"
                           Text="Sürükle veya Alt+←/→ ile de sıralayabilirsin." />
            </StackPanel>
        </Border>
    </Expander>
</UserControl>
