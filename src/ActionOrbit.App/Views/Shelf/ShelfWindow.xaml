<Window x:Class="ActionOrbit.App.Views.Shelf.ShelfWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Action Orbit Pro · Orbit Shelf"
        Icon="/ActionOrbit.App;component/Assets/Brand/ActionOrbit.ico"
        Width="460"
        Height="620"
        MinWidth="380"
        MinHeight="420"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="True"
        Topmost="True"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowDrop="True"
        DragEnter="Shelf_DragEnter"
        DragOver="Shelf_DragOver"
        DragLeave="Shelf_DragLeave"
        Drop="Shelf_Drop"
        PreviewMouseLeftButtonDown="Shelf_PreviewMouseLeftButtonDown"
        PreviewMouseMove="Shelf_PreviewMouseMove"
        AutomationProperties.Name="Yüzen Orbit Shelf">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        </Style>

        <Style x:Key="ShelfMutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style x:Key="ShelfButton" TargetType="Button">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="11,6" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource SoftSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource PrimaryActionBrush}" />
                                <Setter TargetName="Shell" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Shell" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ShelfPrimaryButton" TargetType="Button" BasedOn="{StaticResource ShelfButton}">
            <Setter Property="Foreground" Value="{DynamicResource OnPrimaryActionBrush}" />
            <Setter Property="Background" Value="{DynamicResource PrimaryActionBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryActionBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.88" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ShelfIconButton" TargetType="Button" BasedOn="{StaticResource ShelfButton}">
            <Setter Property="Width" Value="32" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style x:Key="ShelfTextBox" TargetType="TextBox">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="ShelfComboBox" TargetType="ComboBox">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Padding" Value="10,7" />
                        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemShell"
                                            Padding="{TemplateBinding Padding}"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="7">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemShell" Property="Background" Value="{DynamicResource HoverSurfaceBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemShell" Property="Background" Value="{DynamicResource SelectedSurfaceBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="ComboRoot">
                            <Border x:Name="ComboShell"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <Grid>
                                    <TextBlock Margin="10,0,30,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               IsHitTestVisible="False"
                                               Text="{Binding SelectedItem.DisplayName, RelativeSource={RelativeSource TemplatedParent}}"
                                               TextTrimming="CharacterEllipsis" />
                                    <Path Width="8"
                                          Height="5"
                                          Margin="0,0,11,0"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          Data="M 0 0 L 4 4 L 8 0 Z"
                                          Fill="{DynamicResource MutedTextBrush}" />
                                </Grid>
                            </Border>
                            <ToggleButton Background="Transparent"
                                          BorderThickness="0"
                                          Cursor="Hand"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, ElementName=ComboRoot}"
                                        MaxHeight="260"
                                        Margin="0,4,0,0"
                                        Padding="4"
                                        Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource InputBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="9">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboShell" Property="BorderBrush" Value="{DynamicResource PrimaryActionBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboShell" Property="BorderBrush" Value="{DynamicResource PrimaryActionBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ShelfListItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="8"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" Color="#000000" Opacity="0.24" ShadowDepth="6" />
        </Border.Effect>
        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource SoftSurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="14,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image Width="32"
                           Height="32"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Source="/ActionOrbit.App;component/Assets/Brand/ActionOrbitLogo.png"
                           Stretch="Uniform" />
                    <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                        <TextBlock FontSize="14" FontWeight="Bold" Text="Orbit Shelf" />
                        <TextBlock Style="{StaticResource ShelfMutedText}"
                                   Text="{Binding SelectedShelfSummary}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource ShelfIconButton}"
                                ToolTip="Küçült"
                                Content="—"
                                Click="Minimize_Click" />
                        <Button Style="{StaticResource ShelfIconButton}"
                                ToolTip="Kapat"
                                Content="×"
                                Click="Close_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="14,12,14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox DisplayMemberPath="DisplayName"
                          ItemsSource="{Binding Shelves}"
                          SelectedItem="{Binding SelectedShelf}"
                          Style="{StaticResource ShelfComboBox}" />
                <TextBox Grid.Column="1"
                         Margin="8,0,0,0"
                         ToolTip="Raf adını değiştir"
                         Text="{Binding SelectedShelf.Name, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ShelfTextBox}" />
                <StackPanel Grid.Column="2" Margin="6,0,0,0" Orientation="Horizontal">
                    <Button Command="{Binding NewShelfCommand}"
                            Style="{StaticResource ShelfIconButton}"
                            ToolTip="Yeni raf"
                            Content="+" />
                    <Button Command="{Binding TogglePinCommand}"
                            Style="{StaticResource ShelfIconButton}"
                            ToolTip="{Binding SelectedShelfPinButtonText}"
                            Content="⌖" />
                </StackPanel>
            </Grid>

            <Border x:Name="DropZone"
                    Grid.Row="2"
                    Height="92"
                    Margin="14,12,14,0"
                    Background="{DynamicResource InfoSurfaceBrush}"
                    BorderBrush="{DynamicResource InfoBorderBrush}"
                    BorderThickness="2"
                    CornerRadius="14">
                <Grid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource InfoTextBrush}"
                                   Text="Görseli veya dosyayı buraya bırak" />
                        <TextBlock Margin="0,4,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource InfoTextBrush}"
                                   FontSize="11"
                                   Text="Chrome · Explorer · URL · metin" />
                    </StackPanel>
                    <ProgressBar Height="3"
                                 Margin="14,0"
                                 VerticalAlignment="Bottom"
                                 IsIndeterminate="True"
                                 Visibility="{Binding IsImporting, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>
            </Border>

            <Grid Grid.Row="3" Margin="14,12,14,0">
                <Border Padding="24"
                        Background="{DynamicResource SoftSurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedShelf.Items.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="28"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Text="⇣" />
                        <TextBlock Margin="0,6,0,0"
                                   HorizontalAlignment="Center"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Text="Bu raf henüz boş" />
                        <TextBlock Margin="0,4,0,0"
                                   HorizontalAlignment="Center"
                                   Style="{StaticResource ShelfMutedText}"
                                   Text="Bir içeriği yukarıdaki alana sürükle."
                                   TextAlignment="Center" />
                    </StackPanel>
                </Border>

                <ListBox x:Name="ShelfItems"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemContainerStyle="{StaticResource ShelfListItem}"
                         ItemsSource="{Binding SelectedShelf.Items}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8"
                                    Padding="10"
                                    Background="{DynamicResource SoftSurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="13">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="54" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="48" Height="48"
                                            Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10">
                                        <Grid>
                                            <Image Margin="3"
                                                   Source="{Binding PreviewPath}"
                                                   Stretch="UniformToFill"
                                                   Visibility="{Binding IsImage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="20"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       Text="{Binding Glyph}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsImage}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="9,2,8,0">
                                        <TextBlock FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   Text="{Binding DisplayName}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="0,3,0,0"
                                                   Style="{StaticResource ShelfMutedText}"
                                                   Text="{Binding Subtitle}" />
                                        <TextBlock Margin="0,3,0,0"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   Text="Dışarı sürükleyebilirsin"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Button Grid.Column="2"
                                            Command="{Binding DataContext.CopyItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Content="Kopyala"
                                            Style="{StaticResource ShelfPrimaryButton}" />
                                    <WrapPanel Grid.Row="1"
                                               Grid.Column="1"
                                               Grid.ColumnSpan="2"
                                               Margin="9,8,0,0"
                                               HorizontalAlignment="Right">
                                        <Button Command="{Binding DataContext.ResizeImageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Content="1600 px"
                                                Style="{StaticResource ShelfButton}"
                                                Visibility="{Binding IsImage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <Button Command="{Binding DataContext.ConvertToPngCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Content="PNG"
                                                Style="{StaticResource ShelfButton}"
                                                Visibility="{Binding IsImage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <Button Command="{Binding DataContext.SaveItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Content="Kaydet"
                                                Style="{StaticResource ShelfButton}" />
                                        <Button Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Content="Sil"
                                                Style="{StaticResource ShelfButton}" />
                                    </WrapPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <Border Grid.Row="4"
                    Margin="14,10,14,12"
                    Padding="0,9,0,0"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0">
                <Grid>
                    <TextBlock VerticalAlignment="Center"
                               Style="{StaticResource ShelfMutedText}"
                               Text="Sabitlenmeyen içerikler geçicidir."
                               TextTrimming="CharacterEllipsis" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Command="{Binding ClearShelfCommand}"
                                Content="Rafı temizle"
                                Style="{StaticResource ShelfButton}" />
                        <Button Command="{Binding DeleteShelfCommand}"
                                Content="Rafı sil"
                                Style="{StaticResource ShelfButton}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
