<UserControl x:Class="ActionOrbit.App.Views.Profiles.ProfileManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             DataContext="{Binding ProfileEditor}"
             AutomationProperties.Name="Profil yönetimi">
    <UserControl.Resources>
        <Style x:Key="CircleIconButton" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="36" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource SoftSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Circle"
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="18"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Circle" Property="Background" Value="{DynamicResource HoverSurfaceBrush}" />
                                <Setter TargetName="Circle" Property="BorderBrush" Value="{DynamicResource PrimaryActionBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Circle" Property="Background" Value="{DynamicResource PressedSurfaceBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Circle" Property="BorderBrush" Value="{DynamicResource PrimaryActionBrush}" />
                                <Setter TargetName="Circle" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentCircleIconButton"
               TargetType="Button"
               BasedOn="{StaticResource CircleIconButton}">
            <Setter Property="Background" Value="{DynamicResource PrimaryActionBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryActionBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource OnPrimaryActionBrush}" />
        </Style>

        <Style x:Key="DangerCircleIconButton"
               TargetType="Button"
               BasedOn="{StaticResource CircleIconButton}">
            <Setter Property="Background" Value="{DynamicResource DangerSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}" />
        </Style>

        <Style x:Key="CompactProfileListItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,0,0,1"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Border x:Name="SelectionRail"
                                        Width="3"
                                        Margin="0,8,0,8"
                                        HorizontalAlignment="Left"
                                        Background="Transparent"
                                        CornerRadius="2" />
                                <ContentPresenter />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverSurfaceBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource SelectedSurfaceBrush}" />
                                <Setter TargetName="SelectionRail" Property="Background" Value="{DynamicResource PrimaryActionBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource SelectedSurfaceBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="CompactProfileTemplate">
            <Grid MinHeight="58" Margin="14,6,12,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center"
                            ToolTip="{Binding Name}">
                    <TextBlock Foreground="{DynamicResource PrimaryTextBrush}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Text="{Binding Name}"
                               TextTrimming="CharacterEllipsis" />
                    <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                        <TextBlock Foreground="{DynamicResource MutedTextBrush}"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   Text="{Binding Id}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Margin="8,0"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="11"
                                   Text="·" />
                        <TextBlock Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="11"
                                   Text="{Binding Matches.Count, StringFormat={}{0} uygulama}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <TextBlock Margin="0,0,10,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource InfoTextBrush}"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="13"
                               Text="&#xE735;"
                               ToolTip="Varsayılan profil">
                        <TextBlock.Visibility>
                            <MultiBinding Converter="{StaticResource StringEqualityToVisibilityConverter}">
                                <Binding Path="Id" />
                                <Binding Path="DataContext.DefaultProfileId"
                                         RelativeSource="{RelativeSource AncestorType={x:Type ListBox}}" />
                            </MultiBinding>
                        </TextBlock.Visibility>
                    </TextBlock>
                    <TextBlock VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="11"
                               Text="&#xE76C;" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Border Style="{DynamicResource Surface}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center"
                           FontSize="20"
                           FontWeight="Bold"
                           Text="Profiller" />
                <TextBlock Grid.Column="1"
                           Margin="10,0,12,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedTextBrush}"
                           FontSize="12"
                           Text="{Binding ProfileCount}" />
                <Button Grid.Column="2"
                        Margin="0"
                        Command="{Binding AddProfileCommand}"
                        Style="{StaticResource AccentCircleIconButton}"
                        Content="&#xE710;"
                        ToolTip="Yeni profil"
                        AutomationProperties.Name="Yeni profil" />
            </Grid>

            <Border Grid.Row="1"
                    Margin="0,12,0,0"
                    Background="{DynamicResource SoftSurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    ClipToBounds="True">
                <ListBox MaxHeight="220"
                         ItemsSource="{Binding Profiles}"
                         SelectedItem="{Binding SelectedProfile}"
                         ItemTemplate="{StaticResource CompactProfileTemplate}"
                         ItemContainerStyle="{StaticResource CompactProfileListItem}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         AutomationProperties.Name="Profiller" />
            </Border>

            <ScrollViewer Grid.Row="2"
                          Margin="0,12,0,0"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <Border Margin="0,0,4,2"
                        Padding="12"
                        Background="{DynamicResource SoftSurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Margin="0,0,12,0"
                                    Padding="9,2"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource InputBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox MinHeight="32"
                                             Padding="0"
                                             Foreground="{DynamicResource PrimaryTextBrush}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             CaretBrush="{DynamicResource PrimaryTextBrush}"
                                             FontSize="16"
                                             FontWeight="SemiBold"
                                             Text="{Binding SelectedProfileName, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Profil adını düzenle" />
                                    <TextBlock Grid.Column="1"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="12"
                                               Text="&#xE70F;"
                                               IsHitTestVisible="False" />
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Grid Width="36" Margin="0,0,7,0">
                                    <Button Margin="0"
                                            Command="{Binding SetDefaultProfileCommand}"
                                            Style="{StaticResource CircleIconButton}"
                                            Content="&#xE734;"
                                            ToolTip="Varsayılan profil yap"
                                            Visibility="{Binding CanSetDefaultProfile, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            AutomationProperties.Name="Varsayılan profil yap" />
                                    <Border Width="36"
                                            Height="36"
                                            Background="{DynamicResource InfoSurfaceBrush}"
                                            BorderBrush="{DynamicResource InfoBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="18"
                                            ToolTip="Varsayılan profil"
                                            Visibility="{Binding SelectedProfileIsDefault, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource InfoTextBrush}"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="14"
                                                   Text="&#xE735;" />
                                    </Border>
                                </Grid>
                                <Button Command="{Binding DuplicateProfileCommand}"
                                        Style="{StaticResource CircleIconButton}"
                                        Content="&#xE8C8;"
                                        ToolTip="Profili çoğalt"
                                        AutomationProperties.Name="Profili çoğalt" />
                                <Button Margin="0"
                                        Command="{Binding DeleteProfileCommand}"
                                        Style="{StaticResource DangerCircleIconButton}"
                                        Content="&#xE74D;"
                                        ToolTip="Profili sil"
                                        AutomationProperties.Name="Profili sil" />
                            </StackPanel>
                        </Grid>

                        <Border Height="1"
                                Margin="0,12"
                                Background="{DynamicResource BorderBrush}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Text="Uygulamalar" />
                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="11"
                                       Text="{Binding SelectedProfileMatchChips.Count}" />
                        </Grid>

                        <Grid Margin="0,9,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Margin="0,0,8,0"
                                      DisplayMemberPath="DisplayName"
                                      ItemsSource="{Binding RunningApps}"
                                      SelectedItem="{Binding SelectedRunningApp}"
                                      ToolTip="Çalışan uygulamalar" />
                            <Button Grid.Column="1"
                                    Command="{Binding RefreshRunningAppsCommand}"
                                    Style="{StaticResource CircleIconButton}"
                                    Content="&#xE72C;"
                                    ToolTip="Listeyi yenile"
                                    AutomationProperties.Name="Çalışan uygulamaları yenile" />
                            <Button Grid.Column="2"
                                    Margin="0"
                                    Command="{Binding AddSelectedRunningAppToProfileCommand}"
                                    Style="{StaticResource AccentCircleIconButton}"
                                    Content="&#xE710;"
                                    ToolTip="Seçili uygulamayı bağla"
                                    AutomationProperties.Name="Seçili uygulamayı bağla" />
                        </Grid>

                        <Border Margin="0,9,0,0"
                                Padding="9,7"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="11"
                                           Text="Aktif" />
                                <TextBlock Grid.Column="1"
                                           Margin="9,0,8,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           FontFamily="Consolas"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Text="{Binding ActiveProcessName}"
                                           TextTrimming="CharacterEllipsis" />
                                <Button Grid.Column="2"
                                        Width="32"
                                        Height="32"
                                        MinWidth="32"
                                        MinHeight="32"
                                        Margin="0"
                                        Command="{Binding AddActiveProcessToProfileCommand}"
                                        Style="{StaticResource CircleIconButton}"
                                        Content="&#xE81E;"
                                        ToolTip="Aktif pencereyi bağla"
                                        AutomationProperties.Name="Aktif pencereyi bağla" />
                            </Grid>
                        </Border>

                        <ItemsControl Margin="0,10,0,0"
                                      ItemsSource="{Binding SelectedProfileMatchChips}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,6,6"
                                            Padding="9,4,5,4"
                                            Background="{DynamicResource SelectedSurfaceBrush}"
                                            BorderBrush="{DynamicResource SelectedBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock VerticalAlignment="Center"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       FontFamily="Consolas"
                                                       FontSize="11"
                                                       Text="{Binding}" />
                                            <Button Width="22"
                                                    Height="22"
                                                    MinWidth="22"
                                                    MinHeight="22"
                                                    Margin="5,0,0,0"
                                                    Padding="0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Command="{Binding DataContext.ProfileEditor.RemoveProfileMatchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Content="&#xE711;"
                                                    FontFamily="Segoe MDL2 Assets"
                                                    FontSize="9"
                                                    ToolTip="Eşleşmeyi kaldır"
                                                    AutomationProperties.Name="Uygulama eşleşmesini kaldır" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Expander Margin="0,8,0,0"
                                  Header="Gelişmiş">
                            <Grid Margin="0,9,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Style="{DynamicResource TinyLabel}"
                                           Text="Profil kimliği" />
                                <TextBox Grid.Row="1"
                                         Margin="0,5,0,0"
                                         FontFamily="Consolas"
                                         Text="{Binding SelectedProfileId, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Row="2"
                                           Margin="0,10,0,0"
                                           Style="{DynamicResource TinyLabel}"
                                           Text="Elle eşleştirme" />
                                <TextBox Grid.Row="3"
                                         Margin="0,5,0,0"
                                         MinHeight="52"
                                         AcceptsReturn="True"
                                         FontFamily="Consolas"
                                         TextWrapping="Wrap"
                                         Text="{Binding SelectedProfileMatchesText, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </Expander>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
