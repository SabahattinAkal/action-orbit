<UserControl x:Class="ActionOrbit.App.Views.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Uygulama ayarları">
    <UserControl.Resources>
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Padding" Value="14" />
            <Setter Property="Background" Value="{DynamicResource SoftSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <Style x:Key="SettingsSectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        </Style>
        <Style x:Key="SettingsCaption" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SettingsValue" TargetType="TextBlock">
            <Setter Property="MinWidth" Value="58" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,10,18">
            <Grid Margin="2,0,2,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="23" FontWeight="Bold" Text="Ayarlar" />
                    <TextBlock Style="{StaticResource SettingsCaption}"
                               Text="Günlük seçenekler üstte; gelişmiş davranış, Shelf ve yedekleme araçları aşağıda." />
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Margin="18,3,0,0"
                           VerticalAlignment="Top"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Text="Değişiklikler otomatik kaydedilir" />
            </Grid>

            <TextBlock Margin="2,16,0,7"
                       Style="{DynamicResource TinyLabel}"
                       Text="GENEL" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*" />
                    <ColumnDefinition Width="0.95*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Margin="0,0,6,0" Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource SettingsSectionTitle}" Text="Ana kısayol" />
                                <TextBlock Style="{StaticResource SettingsCaption}"
                                           Text="Mouse yazılımındaki makro tuşunu bu kısayolla eşleştir." />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" HorizontalAlignment="Right">
                                <TextBlock HorizontalAlignment="Right"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding Hotkey.HotkeyBadgeForeground}"
                                           Text="{Binding Hotkey.HotkeyStateText}" />
                                <TextBlock Margin="0,3,0,0"
                                           HorizontalAlignment="Right"
                                           FontWeight="Bold"
                                           Text="{Binding Hotkey.HotkeyDisplay}" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox MinWidth="240"
                                     AutomationProperties.Name="Ana kısayol"
                                     Text="{Binding Hotkey.HotkeyInput, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1"
                                    Margin="9,0,0,0"
                                    Command="{Binding Hotkey.SaveHotkeyCommand}"
                                    Content="Uygula"
                                    Style="{DynamicResource PrimaryButton}" />
                        </Grid>
                        <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Hotkey.Suggestions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="0,0,7,7"
                                            Padding="10,5"
                                            Command="{Binding DataContext.Hotkey.UseSuggestedHotkeyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Content="{Binding}"
                                            Style="{DynamicResource SubtleButton}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Margin="0,2,0,0"
                                   Foreground="{DynamicResource DangerTextBrush}"
                                   Text="{Binding Hotkey.HotkeyIssueMessage}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding Hotkey.HasHotkeyIssue, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Margin="6,0,0,0" Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SettingsSectionTitle}" Text="Görünüm" />
                        <TextBlock Style="{StaticResource SettingsCaption}"
                                   Text="Arayüz modunu ve vurgu rengini seç." />
                        <ComboBox Margin="0,11,0,0"
                                  AutomationProperties.Name="Tema modu"
                                  DisplayMemberPath="Label"
                                  ItemsSource="{Binding Settings.ThemeModeOptions}"
                                  SelectedValue="{Binding Settings.ThemeMode}"
                                  SelectedValuePath="Key" />
                        <Grid Margin="0,9,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox AutomationProperties.Name="Vurgu rengi"
                                     Text="{Binding Settings.AccentInput, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1"
                                    Margin="9,0,0,0"
                                    Command="{Binding Settings.ApplyThemeSettingsCommand}"
                                    Content="Uygula"
                                    IsEnabled="{Binding Settings.CanApplyVisualSettings}"
                                    Style="{DynamicResource PrimaryButton}" />
                        </Grid>
                        <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Settings.AccentPresets}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="0,0,7,7"
                                            Padding="9,5"
                                            Command="{Binding DataContext.Settings.UseAccentPresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Color}"
                                            Content="{Binding Label}"
                                            Style="{DynamicResource SubtleButton}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right"
                                    Margin="10,0,0,0"
                                    Padding="9,5"
                                    Command="{Binding Settings.ResetVisualSettingsCommand}"
                                    Content="Varsayılana dön"
                                    Style="{DynamicResource SubtleButton}" />
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="{DynamicResource DangerTextBrush}"
                                       Text="{Binding Settings.AccentIssueMessage}"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding Settings.HasAccentIssue, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Margin="2,16,0,7"
                       Style="{DynamicResource TinyLabel}"
                       Text="HALKA" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Margin="0,0,6,0" Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SettingsSectionTitle}" Text="Boyut ve yerleşim" />
                        <TextBlock Style="{StaticResource SettingsCaption}"
                                   Text="Düğme boyutunu ve halkanın yatay/dikey açılımını ayarla." />
                        <Grid Margin="0,13,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="62" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" Text="Buton boyutu" />
                            <Slider Grid.Column="1" Minimum="54" Maximum="96" TickFrequency="1" Value="{Binding Settings.OverlayButtonSize}" />
                            <TextBlock Grid.Column="2" Style="{StaticResource SettingsValue}" Text="{Binding Settings.OverlayButtonSize, StringFormat={}{0} px}" />
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="62" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" Text="Yatay yarıçap" />
                            <Slider Grid.Column="1" Minimum="96" Maximum="190" TickFrequency="1" Value="{Binding Settings.OverlayRadiusX}" />
                            <TextBlock Grid.Column="2" Style="{StaticResource SettingsValue}" Text="{Binding Settings.OverlayRadiusX, StringFormat={}{0} px}" />
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="62" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" Text="Dikey yarıçap" />
                            <Slider Grid.Column="1" Minimum="82" Maximum="168" TickFrequency="1" Value="{Binding Settings.OverlayRadiusY}" />
                            <TextBlock Grid.Column="2" Style="{StaticResource SettingsValue}" Text="{Binding Settings.OverlayRadiusY, StringFormat={}{0} px}" />
                        </Grid>
                        <CheckBox Margin="0,11,0,0"
                                  Content="Açılış animasyonunu kullan"
                                  IsChecked="{Binding Settings.OverlayAnimation}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Margin="6,0,0,0" Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SettingsSectionTitle}" Text="Tetikleme davranışı" />
                        <TextBlock Style="{StaticResource SettingsCaption}"
                                   Text="Kısayola basıldığında halkanın nasıl açılıp kapanacağını belirle." />
                        <ComboBox Margin="0,11,0,0"
                                  AutomationProperties.Name="Halka tetikleme davranışı"
                                  DisplayMemberPath="Label"
                                  ItemsSource="{Binding Settings.ActivationModeOptions}"
                                  SelectedValue="{Binding Settings.ActivationMode}"
                                  SelectedValuePath="Key" />
                        <Grid Margin="0,12,0,0" IsEnabled="{Binding Settings.IsHoldMode}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="66" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" Text="Basılı tutma" />
                            <Slider Grid.Column="1" Minimum="100" Maximum="1200" TickFrequency="10" Value="{Binding Settings.HoldDelayMilliseconds}" />
                            <TextBlock Grid.Column="2" Style="{StaticResource SettingsValue}" Text="{Binding Settings.HoldDelayMilliseconds, StringFormat={}{0} ms}" />
                        </Grid>
                        <Grid Margin="0,8,0,0" IsEnabled="{Binding Settings.IsDoublePressMode}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="66" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" Text="Çift basma" />
                            <Slider Grid.Column="1" Minimum="200" Maximum="900" TickFrequency="10" Value="{Binding Settings.DoublePressWindowMilliseconds}" />
                            <TextBlock Grid.Column="2" Style="{StaticResource SettingsValue}" Text="{Binding Settings.DoublePressWindowMilliseconds, StringFormat={}{0} ms}" />
                        </Grid>
                        <CheckBox Margin="0,11,0,0"
                                  Content="İmleç dış sınırdan çıkınca halkayı kapat"
                                  IsChecked="{Binding Settings.CancelWhenPointerLeaves}" />
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Margin="2,16,0,7"
                       Style="{DynamicResource TinyLabel}"
                       Text="GELİŞMİŞ" />

            <Expander Header="Uygulama davranışı ve devre dışı bırakılan süreçler"
                      IsExpanded="False">
                <Border Margin="0,8,0,0" Style="{StaticResource SettingsCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,18,0">
                            <TextBlock Style="{StaticResource SettingsSectionTitle}" Text="Uygulama" />
                            <CheckBox Margin="0,12,0,0"
                                      Content="Windows ile başlat"
                                      IsChecked="{Binding Settings.StartupWithWindows}" />
                            <CheckBox Margin="0,9,0,0"
                                      Content="Kapatınca bildirim alanında çalışmaya devam et"
                                      IsChecked="{Binding Settings.CloseToTray}" />
                            <CheckBox Margin="0,13,0,0"
                                      Content="Gelişmiş komut aksiyonlarını etkinleştir"
                                      IsChecked="{Binding Settings.AllowCommandActions}" />
                            <TextBlock Margin="22,4,0,0"
                                       Style="{StaticResource SettingsCaption}"
                                       Text="Kapalı kalması önerilir; açıkken her komut ayrıca onaylanır." />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource SettingsSectionTitle}" Text="Bu uygulamalarda devre dışı" />
                            <TextBlock Style="{StaticResource SettingsCaption}"
                                       Text="Halkanın açılmasını istemediğin process adlarını yaz." />
                            <TextBox Margin="0,10,0,0"
                                     MinHeight="92"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Text="{Binding Settings.SuppressedProcessesText, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Style="{StaticResource SettingsCaption}"
                                       Text="Virgül veya yeni satırla ayır: powerpnt.exe, mstsc.exe" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Expander>

            <Expander Margin="0,10,0,0"
                      Header="Orbit Shelf gizlilik, kalıcılık ve sınırlar"
                      IsExpanded="False">
                <Border Margin="0,8,0,0" Style="{StaticResource SettingsCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,18,0">
                            <TextBlock Style="{StaticResource SettingsSectionTitle}" Text="Gizlilik ve kalıcılık" />
                            <CheckBox Margin="0,11,0,0"
                                      Content="Orbit Shelf'i etkinleştir"
                                      IsChecked="{Binding Settings.ShelfEnabled}" />
                            <StackPanel IsEnabled="{Binding Settings.ShelfEnabled}">
                                <CheckBox Margin="0,9,0,0"
                                          Content="Sabitlenmemiş son rafları da hatırla"
                                          IsChecked="{Binding Settings.RememberRecentShelves}" />
                                <TextBlock Margin="22,4,0,0"
                                           Style="{StaticResource SettingsCaption}"
                                           Text="Kapalıyken yalnızca sabitlenen raflar geri yüklenir." />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" IsEnabled="{Binding Settings.ShelfEnabled}">
                            <TextBlock Style="{StaticResource SettingsSectionTitle}" Text="Raf sınırları" />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="125" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="62" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" Text="Raf başına öğe" />
                                <Slider Grid.Column="1" Minimum="5" Maximum="100" TickFrequency="5" Value="{Binding Settings.ShelfMaxItems}" />
                                <TextBlock Grid.Column="2" Style="{StaticResource SettingsValue}" Text="{Binding Settings.ShelfMaxItems}" />
                            </Grid>
                            <Grid Margin="0,9,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="125" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="62" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" Text="Geçici saklama" />
                                <Slider Grid.Column="1" Minimum="1" Maximum="168" TickFrequency="1" Value="{Binding Settings.ShelfRetentionHours}" />
                                <TextBlock Grid.Column="2" Style="{StaticResource SettingsValue}" Text="{Binding Settings.ShelfRetentionHours, StringFormat={}{0} saat}" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </Expander>

            <Expander Margin="0,10,0,0"
                      Header="Yedekleme ve tanılama"
                      IsExpanded="False">
                <Border Margin="0,8,0,0" Style="{StaticResource SettingsCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,18,0">
                            <TextBlock Style="{StaticResource SettingsSectionTitle}" Text="Config ve profil aktarımı" />
                            <TextBlock Style="{StaticResource SettingsCaption}"
                                       Text="Tüm ayarların veya tek bir profilin yedeğini alıp geri yükle." />
                            <WrapPanel Margin="0,11,0,0">
                                <Button Command="{Binding Transfers.ExportConfigCommand}" Content="Config dışa aktar" />
                                <Button Command="{Binding Transfers.ImportConfigCommand}" Content="Config içe aktar" />
                                <Button Command="{Binding Transfers.ExportProfileCommand}" Content="Profil dışa aktar" />
                                <Button Command="{Binding Transfers.ImportProfileCommand}" Content="Profil içe aktar" />
                            </WrapPanel>
                        </StackPanel>
                        <WrapPanel Grid.Column="1" VerticalAlignment="Bottom">
                            <Button Command="{Binding Transfers.OpenConfigFolderCommand}" Content="Config klasörü" />
                            <Button Margin="0" Command="{Binding Transfers.OpenLogCommand}" Content="Log dosyası" />
                        </WrapPanel>
                    </Grid>
                </Border>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
