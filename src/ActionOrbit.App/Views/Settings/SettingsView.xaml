<UserControl x:Class="ActionOrbit.App.Views.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Uygulama ayarları">
    <Border Style="{DynamicResource SoftSurface}">
        <Expander Header="Uygulama ayarları, tema ve aktarım"
                  IsExpanded="True">
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock FontWeight="Bold" Text="Uygulama" />
                    <CheckBox Margin="0,8,0,0"
                              Content="Windows ile başlat"
                              IsChecked="{Binding Settings.StartupWithWindows}" />
                    <CheckBox Margin="0,6,0,0"
                              Content="Kapatınca tray'e al"
                              IsChecked="{Binding Settings.CloseToTray}" />
                    <CheckBox Margin="0,12,0,0"
                              Content="Gelişmiş komut aksiyonlarını etkinleştir"
                              IsChecked="{Binding Settings.AllowCommandActions}" />
                    <TextBlock Margin="22,4,12,0"
                               TextWrapping="Wrap"
                               Style="{DynamicResource MutedText}"
                               Text="Kapalı kalması önerilir. Açıldığında her komut çalıştırılmadan önce tam komut gösterilerek onay istenir." />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                    <TextBlock FontWeight="Bold" Text="Tema" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0"
                                  Margin="0,0,8,0"
                                  ItemsSource="{Binding Settings.ThemeModeOptions}"
                                  SelectedItem="{Binding Settings.ThemeMode}" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding Settings.AccentInput, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <TextBlock Margin="0,5,0,0"
                               Style="{DynamicResource MutedText}"
                               Text="Accent örn: #A51E39" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,18,12,0">
                    <TextBlock FontWeight="Bold" Text="Overlay" />
                    <Grid Margin="0,7,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="38" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{DynamicResource MutedText}" Text="Buton" />
                        <Slider Grid.Column="1" Minimum="54" Maximum="96" Value="{Binding Settings.OverlayButtonSize}" />
                        <TextBlock Grid.Column="2" HorizontalAlignment="Right" Style="{DynamicResource MutedText}" Text="{Binding Settings.OverlayButtonSize}" />
                    </Grid>
                    <Grid Margin="0,3,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="38" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{DynamicResource MutedText}" Text="Yatay" />
                        <Slider Grid.Column="1" Minimum="96" Maximum="190" Value="{Binding Settings.OverlayRadiusX}" />
                        <TextBlock Grid.Column="2" HorizontalAlignment="Right" Style="{DynamicResource MutedText}" Text="{Binding Settings.OverlayRadiusX}" />
                    </Grid>
                    <Grid Margin="0,3,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="38" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{DynamicResource MutedText}" Text="Dikey" />
                        <Slider Grid.Column="1" Minimum="82" Maximum="168" Value="{Binding Settings.OverlayRadiusY}" />
                        <TextBlock Grid.Column="2" HorizontalAlignment="Right" Style="{DynamicResource MutedText}" Text="{Binding Settings.OverlayRadiusY}" />
                    </Grid>
                    <CheckBox Margin="0,8,0,0"
                              Content="Açılış animasyonu"
                              IsChecked="{Binding Settings.OverlayAnimation}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1"
                            Margin="16,18,0,0"
                            VerticalAlignment="Center">
                    <TextBlock FontWeight="Bold" Text="Aktarım" />
                    <WrapPanel Margin="0,8,0,0">
                        <Button Command="{Binding Settings.ApplyThemeSettingsCommand}" Content="Ayarları Kaydet" />
                        <Button Command="{Binding Transfers.ExportConfigCommand}" Content="Config Dışa Aktar" />
                        <Button Command="{Binding Transfers.ImportConfigCommand}" Content="Config İçe Aktar" />
                    </WrapPanel>
                    <WrapPanel Margin="0,8,0,0">
                        <Button Command="{Binding Transfers.ExportProfileCommand}" Content="Profili Dışa Aktar" />
                        <Button Command="{Binding Transfers.ImportProfileCommand}" Content="Profil İçe Aktar" />
                    </WrapPanel>
                </StackPanel>

                <Border Grid.Row="2"
                        Grid.ColumnSpan="2"
                        Margin="0,18,0,0"
                        Padding="14"
                        Background="{DynamicResource SoftSurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock FontWeight="Bold" Text="Halka tetikleme davranışı" />
                            <ComboBox Margin="0,8,0,0"
                                      DisplayMemberPath="Label"
                                      ItemsSource="{Binding Settings.ActivationModeOptions}"
                                      SelectedValue="{Binding Settings.ActivationMode}"
                                      SelectedValuePath="Key" />
                            <Grid Margin="0,9,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="55" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Style="{DynamicResource MutedText}" Text="Basılı tutma gecikmesi" />
                                <Slider Grid.Column="1" Minimum="100" Maximum="1200" Value="{Binding Settings.HoldDelayMilliseconds}" />
                                <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{DynamicResource MutedText}" Text="{Binding Settings.HoldDelayMilliseconds, StringFormat={}{0} ms}" />
                            </Grid>
                            <Grid Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="55" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Style="{DynamicResource MutedText}" Text="Çift basma aralığı" />
                                <Slider Grid.Column="1" Minimum="200" Maximum="900" Value="{Binding Settings.DoublePressWindowMilliseconds}" />
                                <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{DynamicResource MutedText}" Text="{Binding Settings.DoublePressWindowMilliseconds, StringFormat={}{0} ms}" />
                            </Grid>
                            <CheckBox Margin="0,9,0,0"
                                      Content="İmleç dış sınırdan çıkınca halkayı kapat"
                                      IsChecked="{Binding Settings.CancelWhenPointerLeaves}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock FontWeight="Bold" Text="Bu uygulamalarda devre dışı" />
                            <TextBox Margin="0,8,0,0"
                                     MinHeight="66"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Text="{Binding Settings.SuppressedProcessesText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,6,0,0"
                                       Style="{DynamicResource MutedText}"
                                       TextWrapping="Wrap"
                                       Text="Virgülle ayır. Örn: powerpnt.exe, mstsc.exe, valorant.exe. Bu uygulamalar öndeyken halka açılmaz." />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="3"
                        Grid.ColumnSpan="2"
                        Margin="0,12,0,0"
                        Padding="14"
                        Background="{DynamicResource SoftSurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock FontWeight="Bold" Text="Orbit Shelf gizlilik ve kalıcılık" />
                            <CheckBox Margin="0,8,0,0"
                                      Content="Orbit Shelf'i etkinleştir"
                                      IsChecked="{Binding Settings.ShelfEnabled}" />
                            <CheckBox Margin="0,7,0,0"
                                      Content="Sabitlenmemiş son rafları da hatırla"
                                      IsChecked="{Binding Settings.RememberRecentShelves}" />
                            <TextBlock Margin="22,5,0,0"
                                       Style="{DynamicResource MutedText}"
                                       TextWrapping="Wrap"
                                       Text="Kapalıyken yalnızca açıkça sabitlediğin raflar sonraki açılışta geri yüklenir. Geçici öğeler süre dolunca temizlenir." />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock FontWeight="Bold" Text="Raf sınırları" />
                            <Grid Margin="0,9,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="48" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Style="{DynamicResource MutedText}" Text="Raf başına öğe" />
                                <Slider Grid.Column="1" Minimum="5" Maximum="100" TickFrequency="5" Value="{Binding Settings.ShelfMaxItems}" />
                                <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{DynamicResource MutedText}" Text="{Binding Settings.ShelfMaxItems}" />
                            </Grid>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="58" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Style="{DynamicResource MutedText}" Text="Geçici saklama" />
                                <Slider Grid.Column="1" Minimum="1" Maximum="168" TickFrequency="1" Value="{Binding Settings.ShelfRetentionHours}" />
                                <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{DynamicResource MutedText}" Text="{Binding Settings.ShelfRetentionHours, StringFormat={}{0} saat}" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Expander>
    </Border>
</UserControl>
