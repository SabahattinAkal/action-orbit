<UserControl x:Class="ActionOrbit.App.Views.MiniTools.TimerToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True">
    <StackPanel>
        <TextBlock x:Name="RemainingText"
                   HorizontalAlignment="Center"
                   FontSize="44"
                   FontWeight="SemiBold"
                   Text="05:00" />
        <TextBlock x:Name="StatusText"
                   Margin="0,4,0,14"
                   HorizontalAlignment="Center"
                   FontSize="11"
                   Foreground="{DynamicResource MutedTextBrush}"
                   Text="Hazır" />
        <ProgressBar x:Name="Progress"
                     Height="7"
                     Margin="0,0,0,16"
                     Maximum="100"
                     Value="0"
                     Foreground="{DynamicResource PrimaryActionBrush}"
                     Background="{DynamicResource NavigationBrush}" />
        <TextBlock Margin="0,0,0,8"
                   FontSize="11"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource MutedTextBrush}"
                   Text="HIZLI SÜRE" />
        <UniformGrid Margin="0,0,0,14" Columns="4">
            <Button Margin="0,0,5,0" Tag="1" Content="1 dk" Click="Preset_Click" Style="{DynamicResource ToolButton}" />
            <Button Margin="2,0,3,0" Tag="5" Content="5 dk" Click="Preset_Click" Style="{DynamicResource ToolButton}" />
            <Button Margin="3,0,2,0" Tag="10" Content="10 dk" Click="Preset_Click" Style="{DynamicResource ToolButton}" />
            <Button Margin="5,0,0,0" Tag="25" Content="25 dk" Click="Preset_Click" Style="{DynamicResource ToolButton}" />
        </UniformGrid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="StartButton"
                    Margin="0,0,5,0"
                    Content="Başlat"
                    Click="StartPause_Click"
                    Style="{DynamicResource ToolPrimaryButton}" />
            <Button Grid.Column="1"
                    Margin="5,0,0,0"
                    Content="Sıfırla"
                    Click="Reset_Click"
                    Style="{DynamicResource ToolButton}" />
        </Grid>
    </StackPanel>
</UserControl>
