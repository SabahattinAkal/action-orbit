<UserControl x:Class="ActionOrbit.App.Views.MiniTools.CaffeineToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Border x:Name="StateCard"
                Padding="16"
                Background="{DynamicResource SoftSurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="StateDot"
                        Width="42" Height="42"
                        Background="{DynamicResource NavigationBrush}"
                        CornerRadius="21">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="19"
                               Text="☕" />
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="StateText" FontSize="15" FontWeight="Bold" Text="Uyku engeli kapalı" />
                    <TextBlock x:Name="RemainingText"
                               Margin="0,3,0,0"
                               FontSize="11"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Text="Windows güç ayarları normal çalışıyor" />
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Margin="0,16,0,7"
                   FontSize="11"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource MutedTextBrush}"
                   Text="NE KADAR UYANIK KALSIN?" />
        <ComboBox x:Name="DurationBox"
                  Height="38"
                  Padding="9,6"
                  SelectedIndex="2"
                  Foreground="{DynamicResource PrimaryTextBrush}"
                  Background="{DynamicResource SurfaceBrush}"
                  BorderBrush="{DynamicResource InputBorderBrush}">
            <ComboBoxItem Tag="15" Content="15 dakika" />
            <ComboBoxItem Tag="30" Content="30 dakika" />
            <ComboBoxItem Tag="60" Content="1 saat" />
            <ComboBoxItem Tag="120" Content="2 saat" />
            <ComboBoxItem Tag="0" Content="Ben kapatana kadar" />
        </ComboBox>
        <Button x:Name="ToggleButton"
                Margin="0,14,0,0"
                Content="Uyanık tutmayı başlat"
                Click="Toggle_Click"
                Style="{DynamicResource ToolPrimaryButton}" />
        <TextBlock Margin="0,10,0,0"
                   TextWrapping="Wrap"
                   FontSize="10"
                   Foreground="{DynamicResource MutedTextBrush}"
                   Text="Yalnızca bu oturum boyunca etkilidir; güç planını veya Windows ayarlarını kalıcı olarak değiştirmez." />
    </StackPanel>
</UserControl>
