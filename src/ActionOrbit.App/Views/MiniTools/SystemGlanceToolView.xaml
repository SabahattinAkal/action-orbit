<UserControl x:Class="ActionOrbit.App.Views.MiniTools.SystemGlanceToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Border Padding="14"
                Background="{DynamicResource SoftSurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="13">
            <StackPanel>
                <Grid>
                    <TextBlock FontSize="12" FontWeight="SemiBold" Text="İşlemci" />
                    <TextBlock x:Name="CpuText" HorizontalAlignment="Right" FontSize="14" FontWeight="Bold" Text="—" />
                </Grid>
                <ProgressBar x:Name="CpuProgress"
                             Height="7" Margin="0,9,0,0" Maximum="100"
                             Foreground="{DynamicResource PrimaryActionBrush}"
                             Background="{DynamicResource NavigationBrush}" />
            </StackPanel>
        </Border>
        <Border Margin="0,10,0,0"
                Padding="14"
                Background="{DynamicResource SoftSurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="13">
            <StackPanel>
                <Grid>
                    <StackPanel>
                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="Bellek" />
                        <TextBlock x:Name="MemoryDetailText" Margin="0,3,0,0" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" />
                    </StackPanel>
                    <TextBlock x:Name="MemoryText" HorizontalAlignment="Right" FontSize="14" FontWeight="Bold" Text="—" />
                </Grid>
                <ProgressBar x:Name="MemoryProgress"
                             Height="7" Margin="0,9,0,0" Maximum="100"
                             Foreground="{DynamicResource PrimaryActionBrush}"
                             Background="{DynamicResource NavigationBrush}" />
            </StackPanel>
        </Border>
        <Border Margin="0,10,0,0"
                Padding="14"
                Background="{DynamicResource SoftSurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="13">
            <Grid>
                <StackPanel>
                    <TextBlock FontSize="12" FontWeight="SemiBold" Text="Pil" />
                    <TextBlock x:Name="PowerDetailText" Margin="0,3,0,0" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" />
                </StackPanel>
                <TextBlock x:Name="BatteryText" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="14" FontWeight="Bold" Text="—" />
            </Grid>
        </Border>
        <TextBlock Margin="0,11,0,0"
                   HorizontalAlignment="Center"
                   FontSize="10"
                   Foreground="{DynamicResource MutedTextBrush}"
                   Text="Her saniye yerel Windows sayaçlarından güncellenir" />
    </StackPanel>
</UserControl>
