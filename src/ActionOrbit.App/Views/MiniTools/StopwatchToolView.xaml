<UserControl x:Class="ActionOrbit.App.Views.MiniTools.StopwatchToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock x:Name="ElapsedText"
                   HorizontalAlignment="Center"
                   FontSize="39"
                   FontWeight="SemiBold"
                   Text="00:00:00.00" />
        <TextBlock x:Name="StateText"
                   Margin="0,4,0,14"
                   HorizontalAlignment="Center"
                   FontSize="11"
                   Foreground="{DynamicResource MutedTextBrush}"
                   Text="Hazır" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="StartButton"
                    Margin="0,0,5,0"
                    Content="Başlat"
                    Click="StartPause_Click"
                    Style="{DynamicResource ToolPrimaryButton}" />
            <Button x:Name="LapButton"
                    Grid.Column="1"
                    Margin="3,0"
                    Content="Tur"
                    IsEnabled="False"
                    Click="Lap_Click"
                    Style="{DynamicResource ToolButton}" />
            <Button Grid.Column="2"
                    Margin="5,0,0,0"
                    Content="Sıfırla"
                    Click="Reset_Click"
                    Style="{DynamicResource ToolButton}" />
        </Grid>
        <Border Margin="0,14,0,0"
                Padding="10"
                Background="{DynamicResource SoftSurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="11">
            <Grid>
                <TextBlock x:Name="EmptyLapsText"
                           Margin="4"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Text="Henüz tur kaydı yok" />
                <ListBox x:Name="LapsList"
                         MaxHeight="170"
                         Background="Transparent"
                         BorderThickness="0" />
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
