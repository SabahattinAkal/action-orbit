<UserControl x:Class="ActionOrbit.App.Views.MiniTools.PasswordGeneratorToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="PasswordOptionCard" TargetType="Border">
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="Background" Value="{DynamicResource SoftSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style x:Key="PasswordOptionCheckBox" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <Border Padding="14,12"
                Background="{DynamicResource SoftSurfaceBrush}"
                BorderBrush="{DynamicResource InputBorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Text="ÜRETİLEN PAROLA" />
                        <Border Margin="8,-2,0,0"
                                Padding="7,2"
                                Background="{DynamicResource InfoSurfaceBrush}"
                                BorderBrush="{DynamicResource InfoBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <TextBlock FontSize="9"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource InfoTextBrush}"
                                       Text="YEREL" />
                        </Border>
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               FontSize="10"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Text="Seçmek için tıkla" />
                </Grid>
                <TextBox x:Name="PasswordBox"
                         Margin="0,11,0,0"
                         MinHeight="58"
                         Padding="0"
                         AutomationProperties.Name="Üretilen parola"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         VerticalContentAlignment="Center"
                         FontFamily="Cascadia Mono, Consolas"
                         FontSize="18"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource PrimaryTextBrush}"
                         SelectionBrush="{DynamicResource PrimaryActionBrush}"
                         CaretBrush="{DynamicResource PrimaryTextBrush}"
                         Background="Transparent"
                         BorderThickness="0"
                         PreviewMouseLeftButtonDown="PasswordBox_PreviewMouseLeftButtonDown"
                         ToolTip="Parolanın tamamını seçmek için alana tıkla veya Kopyala düğmesini kullan" />
            </StackPanel>
        </Border>

        <Grid Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontSize="13" FontWeight="SemiBold" Text="Parola uzunluğu" />
                <TextBlock Margin="0,2,0,0"
                           Style="{DynamicResource ToolMutedText}"
                           Text="Daha uzun parolalar genellikle daha güçlüdür." />
            </StackPanel>
            <Border Grid.Column="1"
                    Padding="9,5"
                    VerticalAlignment="Center"
                    Background="{DynamicResource SelectedSurfaceBrush}"
                    BorderBrush="{DynamicResource SelectedBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="9">
                <TextBlock x:Name="LengthText"
                           FontSize="12"
                           FontWeight="Bold"
                           Text="20 karakter" />
            </Border>
        </Grid>
        <Slider x:Name="LengthSlider"
                Margin="0,8,0,8"
                Minimum="12"
                Maximum="64"
                Value="20"
                TickFrequency="1"
                IsSnapToTickEnabled="True"
                ValueChanged="LengthSlider_ValueChanged" />
        <UniformGrid Columns="4">
            <Button Margin="0,0,4,0" Tag="16" Content="16" Click="SetLength_Click" Style="{DynamicResource ToolButton}" />
            <Button Margin="2,0" Tag="20" Content="20" Click="SetLength_Click" Style="{DynamicResource ToolButton}" />
            <Button Margin="2,0" Tag="32" Content="32" Click="SetLength_Click" Style="{DynamicResource ToolButton}" />
            <Button Margin="4,0,0,0" Tag="48" Content="48" Click="SetLength_Click" Style="{DynamicResource ToolButton}" />
        </UniformGrid>

        <TextBlock Margin="0,16,0,3"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Text="Kullanılacak karakterler" />
        <TextBlock Margin="0,0,0,9"
                   Style="{DynamicResource ToolMutedText}"
                   Text="En az bir grup seç. Her seçili gruptan en az bir karakter eklenir." />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Margin="0,0,4,4" Style="{StaticResource PasswordOptionCard}">
                <CheckBox x:Name="LowercaseBox"
                          AutomationProperties.Name="Küçük harf kullan"
                          IsChecked="True"
                          Click="Option_Click"
                          Style="{StaticResource PasswordOptionCheckBox}">
                    <StackPanel Margin="5,0,0,0">
                        <TextBlock FontSize="11" FontWeight="SemiBold" Text="Küçük harf" />
                        <TextBlock FontSize="10" Foreground="{DynamicResource MutedTextBrush}" Text="a b c" />
                    </StackPanel>
                </CheckBox>
            </Border>
            <Border Grid.Column="1" Margin="4,0,0,4" Style="{StaticResource PasswordOptionCard}">
                <CheckBox x:Name="UppercaseBox"
                          AutomationProperties.Name="Büyük harf kullan"
                          IsChecked="True"
                          Click="Option_Click"
                          Style="{StaticResource PasswordOptionCheckBox}">
                    <StackPanel Margin="5,0,0,0">
                        <TextBlock FontSize="11" FontWeight="SemiBold" Text="Büyük harf" />
                        <TextBlock FontSize="10" Foreground="{DynamicResource MutedTextBrush}" Text="A B C" />
                    </StackPanel>
                </CheckBox>
            </Border>
            <Border Grid.Row="1" Margin="0,4,4,0" Style="{StaticResource PasswordOptionCard}">
                <CheckBox x:Name="DigitsBox"
                          AutomationProperties.Name="Rakam kullan"
                          IsChecked="True"
                          Click="Option_Click"
                          Style="{StaticResource PasswordOptionCheckBox}">
                    <StackPanel Margin="5,0,0,0">
                        <TextBlock FontSize="11" FontWeight="SemiBold" Text="Rakam" />
                        <TextBlock FontSize="10" Foreground="{DynamicResource MutedTextBrush}" Text="2 3 4" />
                    </StackPanel>
                </CheckBox>
            </Border>
            <Border Grid.Row="1" Grid.Column="1" Margin="4,4,0,0" Style="{StaticResource PasswordOptionCard}">
                <CheckBox x:Name="SymbolsBox"
                          AutomationProperties.Name="Sembol kullan"
                          IsChecked="True"
                          Click="Option_Click"
                          Style="{StaticResource PasswordOptionCheckBox}">
                    <StackPanel Margin="5,0,0,0">
                        <TextBlock FontSize="11" FontWeight="SemiBold" Text="Sembol" />
                        <TextBlock FontSize="10" Foreground="{DynamicResource MutedTextBrush}" Text="! # %" />
                    </StackPanel>
                </CheckBox>
            </Border>
        </Grid>

        <Border Margin="0,14,0,0"
                Padding="11,9"
                Background="{DynamicResource SoftSurfaceBrush}"
                BorderBrush="{DynamicResource InputBorderBrush}"
                BorderThickness="1"
                CornerRadius="11">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StrengthText"
                               FontSize="12"
                               FontWeight="Bold"
                               Text="Güçlü" />
                    <TextBlock x:Name="StrengthDescriptionText"
                               Grid.Column="1"
                               Margin="9,0,0,0"
                               HorizontalAlignment="Right"
                               FontSize="10"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Text="İyi uzunluk ve çeşitlilik" />
                </Grid>
                <ProgressBar x:Name="StrengthBar"
                             Height="7"
                             Margin="0,8,0,0"
                             Minimum="0"
                             Maximum="4"
                             Value="3"
                             Background="{DynamicResource InputBorderBrush}"
                             Foreground="{DynamicResource PrimaryActionBrush}" />
            </StackPanel>
        </Border>

        <Border Margin="0,10,0,0"
                Padding="10,8"
                Background="{DynamicResource InfoSurfaceBrush}"
                BorderBrush="{DynamicResource InfoBorderBrush}"
                BorderThickness="1"
                CornerRadius="10">
            <TextBlock x:Name="StatusText"
                       FontSize="10"
                       Foreground="{DynamicResource InfoTextBrush}"
                       Text="Güvenli rastgelelikle cihazında üretilir; kaydedilmez. Benzer karakterler I, l, 1, O ve 0 kullanılmaz."
                       TextWrapping="Wrap" />
        </Border>

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Margin="0,0,5,0"
                    AutomationProperties.Name="Yeni parola üret"
                    Content="Yeni parola üret"
                    Click="Generate_Click"
                    Style="{DynamicResource ToolButton}" />
            <Button Grid.Column="1"
                    Margin="5,0,0,0"
                    AutomationProperties.Name="Parolayı kopyala"
                    Content="Parolayı kopyala"
                    Click="Copy_Click"
                    Style="{DynamicResource ToolPrimaryButton}" />
        </Grid>
    </StackPanel>
</UserControl>
