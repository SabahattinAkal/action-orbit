<UserControl x:Class="ActionOrbit.App.Views.MiniTools.PasswordGeneratorToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Border Padding="12"
                Background="{DynamicResource SoftSurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="11">
            <TextBox x:Name="PasswordBox"
                     MinHeight="56"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     VerticalContentAlignment="Center"
                     FontFamily="Consolas"
                     FontSize="17"
                     FontWeight="SemiBold"
                     Background="Transparent"
                     BorderThickness="0" />
        </Border>
        <Grid Margin="0,13,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{DynamicResource ToolMutedText}" Text="Uzunluk" />
            <TextBlock x:Name="LengthText" Grid.Column="1" FontWeight="SemiBold" Text="20 karakter" />
        </Grid>
        <Slider x:Name="LengthSlider"
                Margin="0,4,0,10"
                Minimum="12"
                Maximum="64"
                Value="20"
                TickFrequency="1"
                IsSnapToTickEnabled="True"
                ValueChanged="LengthSlider_ValueChanged" />
        <WrapPanel>
            <CheckBox x:Name="LowercaseBox" Margin="0,0,13,8" Content="Küçük harf" IsChecked="True" Click="Option_Click" />
            <CheckBox x:Name="UppercaseBox" Margin="0,0,13,8" Content="Büyük harf" IsChecked="True" Click="Option_Click" />
            <CheckBox x:Name="DigitsBox" Margin="0,0,13,8" Content="Rakam" IsChecked="True" Click="Option_Click" />
            <CheckBox x:Name="SymbolsBox" Margin="0,0,0,8" Content="Sembol" IsChecked="True" Click="Option_Click" />
        </WrapPanel>
        <Grid Margin="0,5,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="StrengthText" FontWeight="SemiBold" Text="Güçlü" />
                <TextBlock x:Name="StatusText"
                           Margin="0,2,8,0"
                           Style="{DynamicResource ToolMutedText}"
                           Text="Cihazda, güvenli rastgelelik ile üretilir."
                           TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Margin="0,0,7,0" Content="Yenile" Click="Generate_Click" Style="{DynamicResource ToolButton}" />
                <Button Content="Kopyala" Click="Copy_Click" Style="{DynamicResource ToolPrimaryButton}" />
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
