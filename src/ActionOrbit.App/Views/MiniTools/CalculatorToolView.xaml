<UserControl x:Class="ActionOrbit.App.Views.MiniTools.CalculatorToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBox x:Name="ExpressionBox"
                 FontSize="16"
                 Text=""
                 ToolTip="Örn: (12 + 8) / 4"
                 KeyDown="ExpressionBox_KeyDown"
                 Style="{DynamicResource ToolTextBox}" />
        <Border Margin="0,9,0,13"
                Padding="13,10"
                Background="{DynamicResource SoftSurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="11">
            <Grid>
                <TextBlock x:Name="ResultLabel"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Text="Sonuç" />
                <TextBlock x:Name="ResultText"
                           Margin="58,0,0,0"
                           HorizontalAlignment="Right"
                           FontSize="21"
                           FontWeight="SemiBold"
                           Text="—" />
            </Grid>
        </Border>
        <UniformGrid Columns="4" Rows="5">
            <Button Margin="0,0,4,4" Content="C" Click="Clear_Click" Style="{DynamicResource ToolButton}" />
            <Button Margin="2,0,2,4" Tag="(" Content="(" Click="Token_Click" Style="{DynamicResource ToolButton}" />
            <Button Margin="2,0,2,4" Tag=")" Content=")" Click="Token_Click" Style="{DynamicResource ToolButton}" />
            <Button Margin="4,0,0,4" Content="⌫" Click="Backspace_Click" Style="{DynamicResource ToolButton}" />

            <Button Margin="0,2,4,2" Tag="7" Content="7" Click="Token_Click" Style="{DynamicResource ToolButton}" />
            <Button Margin="2" Tag="8" Content="8" Click="Token_Click" Style="{DynamicResource ToolButton}" />
            <Button Margin="2" Tag="9" Content="9" Click="Token_Click" Style="{DynamicResource ToolButton}" />
            <Button Margin="4,2,0,2" Tag="÷" Content="÷" Click="Token_Click" Style="{DynamicResource ToolButton}" />

            <Button Margin="0,2,4,2" Tag="4" Content="4" Click="Token_Click" Style="{DynamicResource ToolButton}" />
            <Button Margin="2" Tag="5" Content="5" Click="Token_Click" Style="{DynamicResource ToolButton}" />
            <Button Margin="2" Tag="6" Content="6" Click="Token_Click" Style="{DynamicResource ToolButton}" />
            <Button Margin="4,2,0,2" Tag="×" Content="×" Click="Token_Click" Style="{DynamicResource ToolButton}" />

            <Button Margin="0,2,4,2" Tag="1" Content="1" Click="Token_Click" Style="{DynamicResource ToolButton}" />
            <Button Margin="2" Tag="2" Content="2" Click="Token_Click" Style="{DynamicResource ToolButton}" />
            <Button Margin="2" Tag="3" Content="3" Click="Token_Click" Style="{DynamicResource ToolButton}" />
            <Button Margin="4,2,0,2" Tag="-" Content="−" Click="Token_Click" Style="{DynamicResource ToolButton}" />

            <Button Margin="0,4,4,0" Tag="0" Content="0" Click="Token_Click" Style="{DynamicResource ToolButton}" />
            <Button Margin="2,4,2,0" Tag="," Content="," Click="Token_Click" Style="{DynamicResource ToolButton}" />
            <Button Margin="2,4,2,0" Tag="%" Content="%" Click="Token_Click" Style="{DynamicResource ToolButton}" />
            <Button Margin="4,4,0,0" Tag="+" Content="+" Click="Token_Click" Style="{DynamicResource ToolButton}" />
        </UniformGrid>
        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Content="=" Click="Evaluate_Click" Style="{DynamicResource ToolPrimaryButton}" />
            <Button Grid.Column="1" Margin="9,0,0,0" Content="Sonucu kopyala" Click="Copy_Click" Style="{DynamicResource ToolButton}" />
        </Grid>
    </StackPanel>
</UserControl>
